<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaUIDesigner.App.ViewModels"
        xmlns:views="using:AvaloniaUIDesigner.App.Views"
        xmlns:pg="using:Avalonia.PropertyGrid.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="800"
        x:Class="AvaloniaUIDesigner.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding WindowTitle}"
        Width="1280"
        Height="800"
        Closing="OnWindowClosing"
        KeyDown="OnWindowKeyDown"
        KeyUp="OnWindowKeyUp">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="New" Click="OnNewMenuClicked"/>
                <MenuItem Header="Duplicate Tab"
                          Click="OnDuplicateDocumentTabMenuClicked"
                          IsEnabled="{Binding CanDuplicateCurrentDocumentTab}"/>
                <MenuItem Header="Rename Tab..."
                          Click="OnRenameDocumentTabMenuClicked"
                          IsEnabled="{Binding CanRenameCurrentDocumentTab}"/>
                <MenuItem Header="Close Tab" Click="OnCloseCurrentTabMenuClicked" IsEnabled="{Binding CanCloseCurrentDocumentTab}"/>
                <MenuItem Header="Close All Tabs"
                          Click="OnCloseAllTabsMenuClicked"
                          IsEnabled="{Binding HasMultipleDocumentTabs}"/>
                <MenuItem Header="Reopen Closed Tab"
                          Click="OnReopenClosedTabMenuClicked"
                          IsEnabled="{Binding CanReopenClosedDocumentTab}"/>
                <MenuItem Header="New from Template">
                    <MenuItem Header="Login Form" Tag="Login" Click="OnTemplateMenuClicked"/>
                    <MenuItem Header="Settings" Tag="Settings" Click="OnTemplateMenuClicked"/>
                    <MenuItem Header="Dashboard" Tag="Dashboard" Click="OnTemplateMenuClicked"/>
                </MenuItem>
                <MenuItem Header="Load Component Pack..." Click="OnLoadComponentPackMenuClicked"/>
                <MenuItem Header="Load Component Pack Plugin..." Click="OnLoadComponentPackPluginMenuClicked"/>
                <MenuItem Header="Manage Component Packs..." Click="OnManageComponentPacksMenuClicked"/>
                <MenuItem Header="Load Toolbox Preset Pack..." Click="OnLoadToolboxPresetPackMenuClicked"/>
                <MenuItem Header="Export Selected as Component Pack..." Click="OnExportSelectedComponentPackMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Export Selected Toolbox Preset..." Click="OnExportSelectedToolboxPresetMenuClicked" IsEnabled="{Binding Toolbox.IsPresetSelected}"/>
                <MenuItem Header="Add Selection to Toolbox..." Click="OnAddSelectionToToolboxMenuClicked" IsEnabled="{Binding Canvas.HasMultipleSelection}"/>
                <MenuItem Header="Open..." Click="OnOpenMenuClicked"/>
                <MenuItem Header="Open Recent" x:Name="OpenRecentMenu"/>
                <Separator/>
                <MenuItem Header="Save" Click="OnSaveMenuClicked"/>
                <MenuItem Header="Save As..." Click="OnSaveAsMenuClicked"/>
                <MenuItem Header="Save All"
                          Click="OnSaveAllMenuClicked"
                          IsEnabled="{Binding HasDirtyDocumentTabs}"/>
                <MenuItem Header="Recover Backup..."
                          x:Name="RecoverBackupMenu"
                          Click="OnRecoverBackupMenuClicked"
                          IsEnabled="False"/>
                <MenuItem Header="Copy AXAML to Clipboard" Click="OnCopyAxamlMenuClicked"/>
                <MenuItem Header="Copy Selected AXAML" Click="OnCopySelectedAxamlMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Export Selected AXAML..." Click="OnExportSelectedAxamlMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Copy UserControl AXAML" Click="OnCopyUserControlAxamlMenuClicked"/>
                <MenuItem Header="Export UserControl AXAML..." Click="OnExportUserControlAxamlMenuClicked"/>
                <MenuItem Header="Validate AXAML" Click="OnValidateAxamlMenuClicked"/>
                <Separator/>
                <MenuItem Header="Exit" Click="OnExitMenuClicked"/>
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="{Binding UndoMenuLabel}" Click="OnUndoMenuClicked" IsEnabled="{Binding CanUndo}"/>
                <MenuItem Header="{Binding RedoMenuLabel}" Click="OnRedoMenuClicked" IsEnabled="{Binding CanRedo}"/>
                <MenuItem Header="History..." Click="OnHistoryMenuClicked" IsEnabled="{Binding HasHistory}"/>
                <Separator/>
                <MenuItem Header="Select All" Click="OnSelectAllMenuClicked"/>
                <MenuItem Header="Lock / Unlock Selection" Click="OnToggleLockMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <Separator/>
                <MenuItem Header="Copy" Click="OnCopyMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Copy Style" Click="OnCopyStyleMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Cut" Click="OnCutMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Paste" Click="OnPasteMenuClicked" IsEnabled="{Binding CanPaste}"/>
                <MenuItem Header="Paste AXAML from Clipboard (Ctrl+Alt+V)" Click="OnPasteAxamlFromClipboardMenuClicked"/>
                <MenuItem Header="Paste Style" Click="OnPasteStyleMenuClicked" IsEnabled="{Binding CanPasteStyle}"/>
                <MenuItem Header="Duplicate" Click="OnDuplicateMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Rename Selected Control..." Click="OnRenameSelectedControlMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Delete" Click="OnDeleteMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <Separator/>
                <MenuItem Header="Edit AXAML Source..." Click="OnEditAxamlSourceMenuClicked"/>
                <MenuItem Header="Edit Root Properties..." Click="OnEditRootPropertiesMenuClicked"/>
                <MenuItem Header="Edit Sample Data..." Click="OnEditSampleDataMenuClicked"/>
                <Separator/>
                <MenuItem Header="Edit Items / Columns..." Click="OnEditItemsMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit DataGrid Behavior... (Ctrl+Alt+Shift+E)" Click="OnEditDataGridBehaviorPropertiesMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit Bindings..." Click="OnEditBindingsMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit Common Properties... (Ctrl+Alt+M)" Click="OnEditCommonPropertiesMenuClicked" IsEnabled="{Binding Canvas.HasMultipleSelection}"/>
                <MenuItem Header="Edit Layout Properties... (Ctrl+Alt+L)" Click="OnEditLayoutPropertiesMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit Selection Bounds... (Ctrl+Alt+B)" Click="OnEditSelectionBoundsMenuClicked" IsEnabled="{Binding Canvas.HasMultipleSelection}"/>
                <MenuItem Header="Edit Typography Properties... (Ctrl+Alt+Y)" Click="OnEditTypographyPropertiesMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit Transform Properties... (Ctrl+Alt+X)" Click="OnEditTransformPropertiesMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit Accessibility &amp; Navigation... (Ctrl+Alt+A)" Click="OnEditAccessibilityPropertiesMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit Interaction &amp; Rendering... (Ctrl+Alt+E)" Click="OnEditInteractionPropertiesMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit Visual Effects... (Ctrl+Alt+F)" Click="OnEditEffectPropertiesMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit Range &amp; Value... (Ctrl+Alt+Shift+R)" Click="OnEditRangePropertiesMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit Text Input... (Ctrl+Alt+Shift+T)" Click="OnEditTextInputPropertiesMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit SelectableTextBlock... (Ctrl+Alt+Shift+B)" Click="OnEditSelectableTextBlockPropertiesMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit MaskedTextBox... (Ctrl+Alt+Shift+M)" Click="OnEditMaskedTextBoxPropertiesMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit Selection Behavior... (Ctrl+Alt+Shift+Q)" Click="OnEditSelectionPropertiesMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit Date &amp; Time Input... (Ctrl+Alt+Shift+D)" Click="OnEditDateTimePropertiesMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit ColorPicker... (Ctrl+Alt+Shift+P)" Click="OnEditColorPickerPropertiesMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit AutoCompleteBox... (Ctrl+Alt+Shift+A)" Click="OnEditAutoCompleteBoxPropertiesMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit Toggle &amp; Choice Behavior... (Ctrl+Alt+Shift+O)" Click="OnEditTogglePropertiesMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit Disclosure &amp; Scrolling... (Ctrl+Alt+Shift+U)" Click="OnEditContainerBehaviorPropertiesMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit SplitView Pane Behavior... (Ctrl+Alt+Shift+V)" Click="OnEditSplitViewPropertiesMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit TabControl Behavior... (Ctrl+Alt+Shift+K)" Click="OnEditTabControlBehaviorPropertiesMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit Image Source &amp; Rendering..." Click="OnEditImagePropertiesMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit Button Actions &amp; Commands..." Click="OnEditButtonPropertiesMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit Grid Definitions..." Click="OnEditGridDefinitionsMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit GridSplitter Behavior... (Ctrl+Alt+Shift+J)" Click="OnEditGridSplitterPropertiesMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Assign to Grid Cell..." Click="OnAssignToGridCellMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Assign to StackPanel..." Click="OnAssignToStackPanelMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Assign to DockPanel..." Click="OnAssignToDockPanelMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Assign to WrapPanel..." Click="OnAssignToWrapPanelMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Assign to UniformGrid..." Click="OnAssignToUniformGridMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Assign to Canvas..." Click="OnAssignToCanvasMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Assign to TabControl..." Click="OnAssignToTabControlMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Assign to SplitView..." Click="OnAssignToSplitViewMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Assign as Container Content..." Click="OnAssignAsContainerContentMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Move StackPanel Item Earlier" Click="OnMoveStackPanelItemEarlierMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Move StackPanel Item Later" Click="OnMoveStackPanelItemLaterMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Move DockPanel Item Earlier" Click="OnMoveDockPanelItemEarlierMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Move DockPanel Item Later" Click="OnMoveDockPanelItemLaterMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Move WrapPanel Item Earlier" Click="OnMoveWrapPanelItemEarlierMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Move WrapPanel Item Later" Click="OnMoveWrapPanelItemLaterMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Move UniformGrid Item Earlier" Click="OnMoveUniformGridItemEarlierMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Move UniformGrid Item Later" Click="OnMoveUniformGridItemLaterMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Move Canvas Item Earlier" Click="OnMoveCanvasItemEarlierMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Move Canvas Item Later" Click="OnMoveCanvasItemLaterMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Remove from Container" Click="OnRemoveFromContainerMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit Content..." Click="OnEditExpanderContentMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit Click Handler..." Click="OnEditButtonClickHandlerMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit Event Handler Map..." Click="OnEditEventHandlerMapMenuClicked"/>
                <MenuItem Header="Edit Tooltip..." Click="OnEditToolTipMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit Accessible Name..." Click="OnEditAccessibleNameMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Enable / Disable Selected" Click="OnToggleEnabledMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Show / Hide Selected" Click="OnToggleVisibilityMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Toggle Multiline TextBox" Click="OnToggleTextBoxMultilineMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit Label Target..." Click="OnEditLabelTargetMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit Tab Order..." Click="OnEditTabOrderMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit Tab Order Map..." Click="OnEditTabOrderMapMenuClicked"/>
                <MenuItem Header="Include / Exclude from Tab Navigation" Click="OnToggleTabStopMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Choose Image..." Click="OnChooseImageMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Edit Path Data..." Click="OnEditPathDataMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <Separator/>
                <MenuItem Header="Style">
                    <MenuItem Header="Edit Appearance..." Click="OnEditAppearanceMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                    <MenuItem Header="Edit Document Styles..." Click="OnEditDocumentStylesMenuClicked"/>
                    <MenuItem Header="Edit Selected Classes..." Click="OnEditSelectedClassesMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                    <MenuItem Header="Preview State" IsEnabled="{Binding Canvas.IsSelectionActive}">
                        <MenuItem Header="Normal" Click="OnPreviewStateNormalMenuClicked"/>
                        <Separator/>
                        <MenuItem Header="Pointer Over" Click="OnPreviewStatePointerOverMenuClicked"/>
                        <MenuItem Header="Pressed" Click="OnPreviewStatePressedMenuClicked"/>
                        <MenuItem Header="Disabled" Click="OnPreviewStateDisabledMenuClicked"/>
                        <MenuItem Header="Focus" Click="OnPreviewStateFocusMenuClicked"/>
                        <MenuItem Header="Focus Visible" Click="OnPreviewStateFocusVisibleMenuClicked"/>
                        <MenuItem Header="Checked" Click="OnPreviewStateCheckedMenuClicked"/>
                        <MenuItem Header="Expanded" Click="OnPreviewStateExpandedMenuClicked"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Edit Color Resources..." Click="OnEditColorResourcesMenuClicked"/>
                    <MenuItem Header="Apply Color Resource..." Click="OnApplyColorResourceMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                    <Separator/>
                    <MenuItem Header="Opacity 100%" Click="OnOpacity100MenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                    <MenuItem Header="Opacity 75%" Click="OnOpacity75MenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                    <MenuItem Header="Opacity 50%" Click="OnOpacity50MenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                    <Separator/>
                    <MenuItem Header="Text Size" IsEnabled="{Binding Canvas.IsSelectionActive}">
                        <MenuItem Header="14px" Click="OnTextSize14MenuClicked"/>
                        <MenuItem Header="18px" Click="OnTextSize18MenuClicked"/>
                        <MenuItem Header="24px" Click="OnTextSize24MenuClicked"/>
                    </MenuItem>
                    <MenuItem Header="Text Color" IsEnabled="{Binding Canvas.IsSelectionActive}">
                        <MenuItem Header="Ink" Click="OnTextColorInkMenuClicked"/>
                        <MenuItem Header="Blue" Click="OnTextColorBlueMenuClicked"/>
                        <MenuItem Header="Red" Click="OnTextColorRedMenuClicked"/>
                    </MenuItem>
                    <MenuItem Header="Text Weight" IsEnabled="{Binding Canvas.IsSelectionActive}">
                        <MenuItem Header="Regular" Click="OnTextWeightRegularMenuClicked"/>
                        <MenuItem Header="Semibold" Click="OnTextWeightSemiboldMenuClicked"/>
                        <MenuItem Header="Bold" Click="OnTextWeightBoldMenuClicked"/>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="Order" IsEnabled="{Binding Canvas.IsSelectionActive}">
                    <MenuItem Header="Bring to Front (Ctrl+Shift+])" Click="OnBringToFrontMenuClicked"/>
                    <MenuItem Header="Send to Back (Ctrl+Shift+[)" Click="OnSendToBackMenuClicked"/>
                    <Separator/>
                    <MenuItem Header="Bring Forward (Ctrl+])" Click="OnBringForwardMenuClicked"/>
                    <MenuItem Header="Send Backward (Ctrl+[)" Click="OnSendBackwardMenuClicked"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Center on Artboard" IsEnabled="{Binding Canvas.IsSelectionActive}">
                    <MenuItem Header="Horizontally (Ctrl+Alt+Shift+X)" Click="OnCenterHorizontallyOnArtboardMenuClicked"/>
                    <MenuItem Header="Vertically (Ctrl+Alt+Shift+Y)" Click="OnCenterVerticallyOnArtboardMenuClicked"/>
                    <MenuItem Header="Both (Ctrl+Alt+Shift+C)" Click="OnCenterOnArtboardMenuClicked"/>
                </MenuItem>
                <MenuItem Header="Align to Artboard" IsEnabled="{Binding Canvas.IsSelectionActive}">
                    <MenuItem Header="Left (Ctrl+Alt+Shift+Left)" Click="OnAlignLeftToArtboardMenuClicked"/>
                    <MenuItem Header="Right (Ctrl+Alt+Shift+Right)" Click="OnAlignRightToArtboardMenuClicked"/>
                    <MenuItem Header="Top (Ctrl+Alt+Shift+Up)" Click="OnAlignTopToArtboardMenuClicked"/>
                    <MenuItem Header="Bottom (Ctrl+Alt+Shift+Down)" Click="OnAlignBottomToArtboardMenuClicked"/>
                </MenuItem>
                <MenuItem Header="Arrange" IsEnabled="{Binding Canvas.HasMultipleSelection}">
                    <MenuItem Header="Align Left (Ctrl+Shift+Left)" Click="OnAlignLeftMenuClicked"/>
                    <MenuItem Header="Align Center (Ctrl+Shift+E)" Click="OnAlignCenterMenuClicked"/>
                    <MenuItem Header="Align Right (Ctrl+Shift+Right)" Click="OnAlignRightMenuClicked"/>
                    <Separator/>
                    <MenuItem Header="Align Top (Ctrl+Shift+Up)" Click="OnAlignTopMenuClicked"/>
                    <MenuItem Header="Align Middle (Ctrl+Shift+M)" Click="OnAlignMiddleMenuClicked"/>
                    <MenuItem Header="Align Bottom (Ctrl+Shift+Down)" Click="OnAlignBottomMenuClicked"/>
                    <Separator/>
                    <MenuItem Header="Distribute Horizontally (Ctrl+Alt+H)" Click="OnDistributeHorizontallyMenuClicked"/>
                    <MenuItem Header="Distribute Vertically (Ctrl+Alt+V)" Click="OnDistributeVerticallyMenuClicked"/>
                    <Separator/>
                    <MenuItem Header="Make Same Width (Ctrl+Alt+Shift+W)" Click="OnMakeSameWidthMenuClicked"/>
                    <MenuItem Header="Make Same Height (Ctrl+Alt+Shift+H)" Click="OnMakeSameHeightMenuClicked"/>
                    <MenuItem Header="Make Same Size (Ctrl+Alt+Shift+S)" Click="OnMakeSameSizeMenuClicked"/>
                </MenuItem>
                <MenuItem Header="Lay Out Selected (Ctrl+Alt+Shift+1..8)" IsEnabled="{Binding Canvas.HasMultipleSelection}">
                    <MenuItem Header="Horizontally (StackPanel, Ctrl+Alt+Shift+1)"
                              Click="OnLayoutSelectedHorizontallyMenuClicked"/>
                    <MenuItem Header="Vertically (StackPanel, Ctrl+Alt+Shift+2)"
                              Click="OnLayoutSelectedVerticallyMenuClicked"/>
                    <MenuItem Header="Grid (Auto, Ctrl+Alt+Shift+3)"
                              Click="OnLayoutSelectedGridMenuClicked"/>
                    <MenuItem Header="UniformGrid (Auto, Ctrl+Alt+Shift+4)"
                              Click="OnLayoutSelectedUniformGridMenuClicked"/>
                    <MenuItem Header="DockPanel (Horizontal, Ctrl+Alt+Shift+5)"
                              Click="OnLayoutSelectedDockPanelHorizontallyMenuClicked"/>
                    <MenuItem Header="DockPanel (Vertical, Ctrl+Alt+Shift+6)"
                              Click="OnLayoutSelectedDockPanelVerticallyMenuClicked"/>
                    <MenuItem Header="WrapPanel (Horizontal, Ctrl+Alt+Shift+7)"
                              Click="OnLayoutSelectedWrapPanelHorizontallyMenuClicked"/>
                    <MenuItem Header="WrapPanel (Vertical, Ctrl+Alt+Shift+8)"
                              Click="OnLayoutSelectedWrapPanelVerticallyMenuClicked"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Group Selected into Canvas (Ctrl+G)" Click="OnGroupSelectedMenuClicked" IsEnabled="{Binding Canvas.HasMultipleSelection}"/>
                <MenuItem Header="Break Selected Layout (Ctrl+Shift+B)" Click="OnBreakSelectedLayoutMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Ungroup Selected Canvas (Ctrl+Shift+U)" Click="OnUngroupSelectedMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem Header="Live Preview" Click="OnPreviewMenuClicked"/>
                <MenuItem Header="Quick Switch Document Tab..."
                          Click="OnQuickSwitchDocumentTabMenuClicked"
                          IsEnabled="{Binding HasMultipleDocumentTabs}"/>
                <Separator/>
                <MenuItem Header="Zoom In (Ctrl+=)" Click="OnZoomInMenuClicked"/>
                <MenuItem Header="Zoom Out (Ctrl+-)" Click="OnZoomOutMenuClicked"/>
                <MenuItem Header="Actual Size (100%, Ctrl+0)" Click="OnResetZoomMenuClicked"/>
                <MenuItem Header="Fit to View (F)" Click="OnFitToViewMenuClicked"/>
                <MenuItem Header="Fit Selected to View (Ctrl+Shift+F)"
                          Click="OnFitSelectedToViewMenuClicked"
                          IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem x:Name="PanCanvasMenu"
                          Header="Pan Canvas (Space + Left Drag / Middle Drag / Ctrl+Alt+Arrow) | Pan Tool (H)"
                          Click="OnPanToolMenuClicked"
                          IsChecked="False"/>
                <MenuItem Header="Zoom Presets">
                    <MenuItem Header="25%" Tag="0.25" Click="OnZoomPresetMenuClicked"/>
                    <MenuItem Header="50%" Tag="0.5" Click="OnZoomPresetMenuClicked"/>
                    <MenuItem Header="75%" Tag="0.75" Click="OnZoomPresetMenuClicked"/>
                    <MenuItem Header="100%" Tag="1" Click="OnZoomPresetMenuClicked"/>
                    <MenuItem Header="125%" Tag="1.25" Click="OnZoomPresetMenuClicked"/>
                    <MenuItem Header="150%" Tag="1.5" Click="OnZoomPresetMenuClicked"/>
                    <MenuItem Header="200%" Tag="2" Click="OnZoomPresetMenuClicked"/>
                    <Separator/>
                    <MenuItem Header="Custom..." Click="OnCustomZoomMenuClicked"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Artboard Size">
                    <MenuItem Header="Desktop (1280 x 800)" Click="OnDesktopArtboardMenuClicked"/>
                    <MenuItem Header="Tablet (1024 x 768)" Click="OnTabletArtboardMenuClicked"/>
                    <MenuItem Header="Mobile (390 x 844)" Click="OnMobileArtboardMenuClicked"/>
                    <Separator/>
                    <MenuItem Header="Custom..." Click="OnCustomArtboardSizeMenuClicked"/>
                    <MenuItem Header="Rotate Artboard" Click="OnRotateArtboardMenuClicked"/>
                </MenuItem>
                <MenuItem Header="Artboard Background">
                    <MenuItem Header="White" Click="OnWhiteArtboardBackgroundMenuClicked"/>
                    <MenuItem Header="Soft Gray" Click="OnGrayArtboardBackgroundMenuClicked"/>
                    <MenuItem Header="Ink" Click="OnInkArtboardBackgroundMenuClicked"/>
                    <MenuItem Header="Custom..." Click="OnCustomArtboardBackgroundMenuClicked"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Show Grid (Ctrl+Alt+G)"
                          ToggleType="CheckBox"
                          IsChecked="{Binding Canvas.IsGridVisible, Mode=OneWay}"
                          Click="OnShowGridMenuClicked"/>
                <MenuItem Header="Grid Size">
                    <MenuItem Header="4px" Click="OnGridSize4MenuClicked"/>
                    <MenuItem Header="8px" Click="OnGridSize8MenuClicked"/>
                    <MenuItem Header="16px" Click="OnGridSize16MenuClicked"/>
                    <Separator/>
                    <MenuItem Header="Custom..." Click="OnCustomGridSizeMenuClicked"/>
                </MenuItem>
                <MenuItem Header="Snap to Grid (Ctrl+Alt+Shift+G)"
                          ToggleType="CheckBox"
                          IsChecked="{Binding Canvas.SnapToGrid, Mode=OneWay}"
                          Click="OnSnapToGridMenuClicked"/>
                <MenuItem Name="ShowDesignGuidesMenu"
                          Header="Show Design Guides"
                          ToggleType="CheckBox"
                          IsChecked="True"
                          Click="OnShowDesignGuidesMenuClicked"/>
                <MenuItem Name="SnapToGuidesMenu"
                          Header="Snap to Guides"
                          ToggleType="CheckBox"
                          IsChecked="True"
                          Click="OnSnapToGuidesMenuClicked"/>
                <MenuItem Header="Clear Design Guides" Click="OnClearDesignGuidesMenuClicked"/>
                <Separator/>
                <MenuItem Header="Panels">
                    <MenuItem Name="ShowToolboxMenu"
                              Header="Toolbox (Ctrl+Alt+1)"
                              ToggleType="CheckBox"
                              IsChecked="True"
                              Click="OnShowToolboxMenuClicked"/>
                    <MenuItem Name="ShowObjectTreeMenu"
                              Header="Object Tree (Ctrl+Alt+2)"
                              ToggleType="CheckBox"
                              IsChecked="True"
                              Click="OnShowObjectTreeMenuClicked"/>
                    <MenuItem Name="ShowPropertyInspectorMenu"
                              Header="Property Inspector (Ctrl+Alt+3)"
                              ToggleType="CheckBox"
                              IsChecked="True"
                              Click="OnShowPropertyInspectorMenuClicked"/>
                    <Separator/>
                    <MenuItem Header="Reset Panel Layout (Ctrl+Alt+0)" Click="OnResetPanelLayoutMenuClicked"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="Keyboard Shortcuts..." Click="OnKeyboardShortcutsMenuClicked"/>
                <MenuItem Header="About AvaloniaUIDesigner..." Click="OnAboutMenuClicked"/>
            </MenuItem>
        </Menu>

        <Border Name="DesignToolbar"
                DockPanel.Dock="Top"
                Background="#F8FAFC"
                BorderBrush="#CBD5E1"
                BorderThickness="0,0,0,1"
                Padding="6,4">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Hidden">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Design"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               Foreground="#334155"
                               Margin="2,0,4,0"/>
                    <Border Width="1" Background="#CBD5E1" Margin="0,2"/>
                    <Button Content="Select"
                            Click="OnSelectToolClicked"
                            ToolTip.Tip="Return to the canvas selection tool"
                            Padding="8,3"/>
                    <ToggleButton Content="Pick"
                                  IsChecked="{Binding Toolbox.IsPlacementModeActive, Mode=OneWay}"
                                  Click="OnToggleToolboxPlacementModeClicked"
                                  ToolTip.Tip="Pick a Toolbox control and place it on the canvas"
                                  Padding="8,3"/>
                    <ToggleButton Name="PanTool"
                                  Content="Pan"
                                  Click="OnPanToolClicked"
                                  ToolTip.Tip="Pan the design viewport with left drag"
                                  Padding="8,3"/>
                    <TextBlock Text="{Binding Toolbox.PlacementModeLabel}"
                               IsVisible="{Binding Toolbox.IsPlacementModeActive}"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="#0369A1"
                               MaxWidth="190"
                               TextTrimming="CharacterEllipsis"/>
                    <Border Width="1" Background="#CBD5E1" Margin="0,2"/>
                    <Button Content="New"
                            Click="OnNewMenuClicked"
                            ToolTip.Tip="Create a new document tab"
                            Padding="8,3"/>
                    <Button Content="Save"
                            Click="OnSaveMenuClicked"
                            ToolTip.Tip="Save the active document"
                            Padding="8,3"/>
                    <Button Content="Undo"
                            Click="OnUndoMenuClicked"
                            IsEnabled="{Binding CanUndo}"
                            ToolTip.Tip="Undo the last document change"
                            Padding="8,3"/>
                    <Button Content="Redo"
                            Click="OnRedoMenuClicked"
                            IsEnabled="{Binding CanRedo}"
                            ToolTip.Tip="Redo the last document change"
                            Padding="8,3"/>
                    <Border Width="1" Background="#CBD5E1" Margin="0,2"/>
                    <Button Content="Select All"
                            Click="OnSelectAllMenuClicked"
                            ToolTip.Tip="Select all visible unlocked controls"
                            Padding="8,3"/>
                    <Button Content="Copy"
                            Click="OnCopyMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Copy the selected controls"
                            Padding="7,3"/>
                    <Button Content="Paste"
                            Click="OnPasteMenuClicked"
                            IsEnabled="{Binding CanPaste}"
                            ToolTip.Tip="Paste the current designer clipboard"
                            Padding="7,3"/>
                    <Button Content="Delete"
                            Click="OnDeleteMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Delete the selected controls"
                            Padding="7,3"/>
                    <Button Content="Copy Style"
                            Click="OnCopyStyleMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Copy the selected visual style"
                            Padding="7,3"/>
                    <Button Content="Paste Style"
                            Click="OnPasteStyleMenuClicked"
                            IsEnabled="{Binding CanPasteStyle}"
                            ToolTip.Tip="Paste the copied visual style"
                            Padding="7,3"/>
                    <Button Content="Preview"
                            Click="OnPreviewMenuClicked"
                            ToolTip.Tip="Open or refresh the live preview"
                            Padding="8,3"/>
                    <Border Width="1" Background="#CBD5E1" Margin="0,2"/>
                    <TextBlock Text="Align"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="#64748B"
                               Margin="2,0,0,0"/>
                    <Button Content="L"
                            Click="OnAlignLeftMenuClicked"
                            IsEnabled="{Binding Canvas.HasMultipleSelection}"
                            ToolTip.Tip="Align left edges"
                            MinWidth="30"
                            Padding="5,3"/>
                    <Button Content="C"
                            Click="OnAlignCenterMenuClicked"
                            IsEnabled="{Binding Canvas.HasMultipleSelection}"
                            ToolTip.Tip="Align horizontal centers"
                            MinWidth="30"
                            Padding="5,3"/>
                    <Button Content="R"
                            Click="OnAlignRightMenuClicked"
                            IsEnabled="{Binding Canvas.HasMultipleSelection}"
                            ToolTip.Tip="Align right edges"
                            MinWidth="30"
                            Padding="5,3"/>
                    <Button Content="T"
                            Click="OnAlignTopMenuClicked"
                            IsEnabled="{Binding Canvas.HasMultipleSelection}"
                            ToolTip.Tip="Align top edges"
                            MinWidth="30"
                            Padding="5,3"/>
                    <Button Content="M"
                            Click="OnAlignMiddleMenuClicked"
                            IsEnabled="{Binding Canvas.HasMultipleSelection}"
                            ToolTip.Tip="Align vertical centers"
                            MinWidth="30"
                            Padding="5,3"/>
                    <Button Content="B"
                            Click="OnAlignBottomMenuClicked"
                            IsEnabled="{Binding Canvas.HasMultipleSelection}"
                            ToolTip.Tip="Align bottom edges"
                            MinWidth="30"
                            Padding="5,3"/>
                    <Button Content="Dist H"
                            Click="OnDistributeHorizontallyMenuClicked"
                            IsEnabled="{Binding Canvas.HasMultipleSelection}"
                            ToolTip.Tip="Distribute controls horizontally"
                            Padding="7,3"/>
                    <Button Content="Dist V"
                            Click="OnDistributeVerticallyMenuClicked"
                            IsEnabled="{Binding Canvas.HasMultipleSelection}"
                            ToolTip.Tip="Distribute controls vertically"
                            Padding="7,3"/>
                    <Border Width="1" Background="#CBD5E1" Margin="0,2"/>
                    <TextBlock Text="Size"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="#64748B"
                               Margin="2,0,0,0"/>
                    <Button Content="W"
                            Click="OnMakeSameWidthMenuClicked"
                            IsEnabled="{Binding Canvas.HasMultipleSelection}"
                            ToolTip.Tip="Make selected controls the same width"
                            MinWidth="30"
                            Padding="5,3"/>
                    <Button Content="H"
                            Click="OnMakeSameHeightMenuClicked"
                            IsEnabled="{Binding Canvas.HasMultipleSelection}"
                            ToolTip.Tip="Make selected controls the same height"
                            MinWidth="30"
                            Padding="5,3"/>
                    <Button Content="W+H"
                            Click="OnMakeSameSizeMenuClicked"
                            IsEnabled="{Binding Canvas.HasMultipleSelection}"
                            ToolTip.Tip="Make selected controls the same size"
                            Padding="6,3"/>
                    <Button Name="EditSelectionBoundsToolbar"
                            Content="Bounds"
                            Click="OnEditSelectionBoundsMenuClicked"
                            IsEnabled="{Binding Canvas.HasMultipleSelection}"
                            ToolTip.Tip="Edit the numeric bounds of the selection (Ctrl+Alt+B)"
                            Padding="7,3"/>
                    <Button Name="EditCommonPropertiesToolbar"
                            Content="Common"
                            Click="OnEditCommonPropertiesMenuClicked"
                            IsEnabled="{Binding Canvas.HasMultipleSelection}"
                            ToolTip.Tip="Edit common properties for the selection (Ctrl+Alt+M)"
                            Padding="7,3"/>
                    <Button Name="EditLayoutPropertiesToolbar"
                            Content="Layout"
                            Click="OnEditLayoutPropertiesMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Edit layout properties for the selected control (Ctrl+Alt+L)"
                            Padding="7,3"/>
                    <Button Name="EditTypographyPropertiesToolbar"
                            Content="Typography"
                            Click="OnEditTypographyPropertiesMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Edit typography properties for the selected control (Ctrl+Alt+Y)"
                            Padding="7,3"/>
                    <Button Name="EditTransformPropertiesToolbar"
                            Content="Transform"
                            Click="OnEditTransformPropertiesMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Edit transform properties for the selected control (Ctrl+Alt+X)"
                            Padding="7,3"/>
                    <Button Name="EditAccessibilityPropertiesToolbar"
                            Content="Accessibility"
                            Click="OnEditAccessibilityPropertiesMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Edit accessibility and navigation properties for the selected control (Ctrl+Alt+A)"
                            Padding="7,3"/>
                    <Button Name="EditInteractionPropertiesToolbar"
                            Content="Interaction"
                            Click="OnEditInteractionPropertiesMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Edit interaction and rendering properties for the selected control (Ctrl+Alt+E)"
                            Padding="7,3"/>
                    <Button Name="EditEffectPropertiesToolbar"
                            Content="Effects"
                            Click="OnEditEffectPropertiesMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Edit visual effects for the selected control (Ctrl+Alt+F)"
                            Padding="7,3"/>
                    <Button Name="EditRangePropertiesToolbar"
                            Content="Range"
                            Click="OnEditRangePropertiesMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Edit range and value properties for the selected control (Ctrl+Alt+Shift+R)"
                            Padding="7,3"/>
                    <Button Name="EditTextInputPropertiesToolbar"
                            Content="Text Input"
                            Click="OnEditTextInputPropertiesMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Edit text input properties for the selected TextBox (Ctrl+Alt+Shift+T)"
                            Padding="7,3"/>
                    <Button Name="EditSelectableTextBlockPropertiesToolbar"
                            Content="Selectable Text"
                            Click="OnEditSelectableTextBlockPropertiesMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Edit SelectableTextBlock selection styling (Ctrl+Alt+Shift+B)"
                            Padding="7,3"/>
                    <Button Name="EditMaskedTextBoxPropertiesToolbar"
                            Content="Masked Text"
                            Click="OnEditMaskedTextBoxPropertiesMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Edit MaskedTextBox mask behavior (Ctrl+Alt+Shift+M)"
                            Padding="7,3"/>
                    <Button Name="EditSelectionPropertiesToolbar"
                            Content="Selection"
                            Click="OnEditSelectionPropertiesMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Edit selection behavior for ComboBox, ListBox, or TreeView (Ctrl+Alt+Shift+Q)"
                            Padding="7,3"/>
                    <Button Name="EditDateTimePropertiesToolbar"
                            Content="Date &amp; Time"
                            Click="OnEditDateTimePropertiesMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Edit DatePicker, Calendar, and TimePicker values (Ctrl+Alt+Shift+D)"
                            Padding="7,3"/>
                    <Button Name="EditColorPickerPropertiesToolbar"
                            Content="Color Picker"
                            Click="OnEditColorPickerPropertiesMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Edit ColorPicker color and palette behavior (Ctrl+Alt+Shift+P)"
                            Padding="7,3"/>
                    <Button Name="EditAutoCompleteBoxPropertiesToolbar"
                            Content="AutoComplete"
                            Click="OnEditAutoCompleteBoxPropertiesMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Edit AutoCompleteBox completion and drop-down behavior (Ctrl+Alt+Shift+A)"
                            Padding="7,3"/>
                    <Button Name="EditTogglePropertiesToolbar"
                            Content="Toggle &amp; Choice"
                            Click="OnEditTogglePropertiesMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Edit CheckBox, RadioButton, ToggleSwitch, and ToggleButton behavior (Ctrl+Alt+Shift+O)"
                            Padding="7,3"/>
                    <Button Name="EditContainerBehaviorPropertiesToolbar"
                            Content="Disclosure &amp; Scroll"
                            Click="OnEditContainerBehaviorPropertiesMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Edit Expander disclosure and ScrollViewer scrolling behavior (Ctrl+Alt+Shift+U)"
                            Padding="7,3"/>
                    <Button Name="EditSplitViewPropertiesToolbar"
                            Content="SplitView Pane"
                            Click="OnEditSplitViewPropertiesMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Edit SplitView pane presentation and scrolling behavior (Ctrl+Alt+Shift+V)"
                            Padding="7,3"/>
                    <Button Name="EditTabControlBehaviorPropertiesToolbar"
                            Content="TabControl"
                            Click="OnEditTabControlBehaviorPropertiesMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Edit TabControl tab strip and content alignment behavior (Ctrl+Alt+Shift+K)"
                            Padding="7,3"/>
                    <Button Name="EditDataGridBehaviorPropertiesToolbar"
                            Content="DataGrid"
                            Click="OnEditDataGridBehaviorPropertiesMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Edit DataGrid table behavior and sizing policy (Ctrl+Alt+Shift+E)"
                            Padding="7,3"/>
                    <Button Name="EditGridSplitterPropertiesToolbar"
                            Content="GridSplitter"
                            Click="OnEditGridSplitterPropertiesMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Edit GridSplitter resize direction, behavior, and increments (Ctrl+Alt+Shift+J)"
                            Padding="7,3"/>
                    <Border Width="1" Background="#CBD5E1" Margin="0,2"/>
                    <TextBlock Text="Order"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="#64748B"
                               Margin="2,0,0,0"/>
                    <Button Content="Front"
                            Click="OnBringToFrontMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Bring selected controls to the front"
                            Padding="7,3"/>
                    <Button Content="Back"
                            Click="OnSendToBackMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Send selected controls to the back"
                            Padding="7,3"/>
                    <Button Content="Forward"
                            Click="OnBringForwardMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Bring selected controls forward one layer"
                            Padding="7,3"/>
                    <Button Content="Backward"
                            Click="OnSendBackwardMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Send selected controls backward one layer"
                            Padding="7,3"/>
                    <Border Width="1" Background="#CBD5E1" Margin="0,2"/>
                    <TextBlock Text="Center"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="#64748B"
                               Margin="2,0,0,0"/>
                    <Button Content="X"
                            Click="OnCenterHorizontallyOnArtboardMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Center selected controls horizontally on the artboard"
                            MinWidth="30"
                            Padding="5,3"/>
                    <Button Content="Y"
                            Click="OnCenterVerticallyOnArtboardMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Center selected controls vertically on the artboard"
                            MinWidth="30"
                            Padding="5,3"/>
                    <Button Content="XY"
                            Click="OnCenterOnArtboardMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Center selected controls on both axes"
                            MinWidth="34"
                            Padding="5,3"/>
                    <TextBlock Text="Form"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="#64748B"
                               Margin="2,0,0,0"/>
                    <Button Content="Left"
                            Click="OnAlignLeftToArtboardMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Align selected root controls to the artboard left edge"
                            Padding="7,3"/>
                    <Button Content="Right"
                            Click="OnAlignRightToArtboardMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Align selected root controls to the artboard right edge"
                            Padding="7,3"/>
                    <Button Content="Top"
                            Click="OnAlignTopToArtboardMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Align selected root controls to the artboard top edge"
                            Padding="7,3"/>
                    <Button Content="Bottom"
                            Click="OnAlignBottomToArtboardMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Align selected root controls to the artboard bottom edge"
                            Padding="7,3"/>
                    <TextBlock Text="Artboard"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="#64748B"
                               Margin="2,0,0,0"/>
                    <Button Content="Desktop"
                            Click="OnDesktopArtboardMenuClicked"
                            ToolTip.Tip="Set the artboard to 1280 x 800"
                            Padding="7,3"/>
                    <Button Content="Tablet"
                            Click="OnTabletArtboardMenuClicked"
                            ToolTip.Tip="Set the artboard to 1024 x 768"
                            Padding="7,3"/>
                    <Button Content="Mobile"
                            Click="OnMobileArtboardMenuClicked"
                            ToolTip.Tip="Set the artboard to 390 x 844"
                            Padding="7,3"/>
                    <Button Content="Rotate"
                            Click="OnRotateArtboardMenuClicked"
                            ToolTip.Tip="Swap the artboard width and height"
                            Padding="7,3"/>
                    <Button Content="Custom"
                            Click="OnCustomArtboardSizeMenuClicked"
                            ToolTip.Tip="Enter a custom artboard size"
                            Padding="7,3"/>
                    <TextBlock Text="{Binding Canvas.ArtboardSizeSummary}"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="#0369A1"
                               MinWidth="72"
                               TextAlignment="Center"
                               ToolTip.Tip="Current artboard width x height"/>
                    <Border Width="1" Background="#CBD5E1" Margin="0,2"/>
                    <Button Content="Group"
                            Click="OnGroupSelectedMenuClicked"
                            IsEnabled="{Binding Canvas.HasMultipleSelection}"
                            ToolTip.Tip="Group the selection into a Canvas"
                            Padding="8,3"/>
                    <Button Content="Ungroup"
                            Click="OnUngroupSelectedMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Ungroup the selected Canvas"
                            Padding="8,3"/>
                    <Button Content="Break"
                            Click="OnBreakSelectedLayoutMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Break the selected layout"
                            Padding="8,3"/>
                    <Border Width="1" Background="#CBD5E1" Margin="0,2"/>
                    <TextBlock Text="Layout"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="#64748B"
                               Margin="2,0,0,0"/>
                    <Button Content="Stack H"
                            Click="OnLayoutSelectedHorizontallyMenuClicked"
                            IsEnabled="{Binding Canvas.HasMultipleSelection}"
                            ToolTip.Tip="Create a horizontal StackPanel"
                            Padding="7,3"/>
                    <Button Content="Stack V"
                            Click="OnLayoutSelectedVerticallyMenuClicked"
                            IsEnabled="{Binding Canvas.HasMultipleSelection}"
                            ToolTip.Tip="Create a vertical StackPanel"
                            Padding="7,3"/>
                    <Button Content="Grid"
                            Click="OnLayoutSelectedGridMenuClicked"
                            IsEnabled="{Binding Canvas.HasMultipleSelection}"
                            ToolTip.Tip="Create an automatic Grid layout"
                            Padding="7,3"/>
                    <Button Content="Uniform"
                            Click="OnLayoutSelectedUniformGridMenuClicked"
                            IsEnabled="{Binding Canvas.HasMultipleSelection}"
                            ToolTip.Tip="Create an automatic UniformGrid layout"
                            Padding="7,3"/>
                    <Button Content="Dock H"
                            Click="OnLayoutSelectedDockPanelHorizontallyMenuClicked"
                            IsEnabled="{Binding Canvas.HasMultipleSelection}"
                            ToolTip.Tip="Create a horizontal DockPanel"
                            Padding="7,3"/>
                    <Button Content="Dock V"
                            Click="OnLayoutSelectedDockPanelVerticallyMenuClicked"
                            IsEnabled="{Binding Canvas.HasMultipleSelection}"
                            ToolTip.Tip="Create a vertical DockPanel"
                            Padding="7,3"/>
                    <Button Content="Wrap H"
                            Click="OnLayoutSelectedWrapPanelHorizontallyMenuClicked"
                            IsEnabled="{Binding Canvas.HasMultipleSelection}"
                            ToolTip.Tip="Create a horizontal WrapPanel"
                            Padding="7,3"/>
                    <Button Content="Wrap V"
                            Click="OnLayoutSelectedWrapPanelVerticallyMenuClicked"
                            IsEnabled="{Binding Canvas.HasMultipleSelection}"
                            ToolTip.Tip="Create a vertical WrapPanel"
                            Padding="7,3"/>
                    <Button Content="Lock"
                            Click="OnToggleLockMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Lock or unlock the selection"
                            Padding="7,3"/>
                    <Border Width="1" Background="#CBD5E1" Margin="0,2"/>
                    <ToggleButton Content="Grid"
                                  Click="OnShowGridMenuClicked"
                                  IsChecked="{Binding Canvas.IsGridVisible, Mode=OneWay}"
                                  ToolTip.Tip="Show or hide the design grid"
                                  Padding="7,3"/>
                    <ToggleButton Content="Snap"
                                  Click="OnSnapToGridMenuClicked"
                                  IsChecked="{Binding Canvas.SnapToGrid, Mode=OneWay}"
                                  ToolTip.Tip="Toggle snap to grid"
                                  Padding="7,3"/>
                    <TextBlock Text="Grid Size"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="#64748B"
                               Margin="2,0,0,0"/>
                    <Button Name="GridSize4Toolbar"
                            Content="4"
                            Click="OnGridSize4MenuClicked"
                            ToolTip.Tip="Set the design grid spacing to 4px"
                            MinWidth="28"
                            Padding="5,3"/>
                    <Button Name="GridSize8Toolbar"
                            Content="8"
                            Click="OnGridSize8MenuClicked"
                            ToolTip.Tip="Set the design grid spacing to 8px"
                            MinWidth="28"
                            Padding="5,3"/>
                    <Button Name="GridSize16Toolbar"
                            Content="16"
                            Click="OnGridSize16MenuClicked"
                            ToolTip.Tip="Set the design grid spacing to 16px"
                            MinWidth="32"
                            Padding="5,3"/>
                    <Button Name="GridSizeCustomToolbar"
                            Content="..."
                            Click="OnCustomGridSizeMenuClicked"
                            ToolTip.Tip="Set a custom design grid spacing"
                            MinWidth="32"
                            Padding="5,3"/>
                    <TextBlock Name="GridSizeSummaryToolbar"
                               Text="{Binding Canvas.GridSizeSummary}"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="#0369A1"
                               MinWidth="48"
                               TextAlignment="Center"
                               ToolTip.Tip="Current design grid spacing"/>
                    <TextBlock Text="Guides"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="#64748B"
                               Margin="2,0,0,0"/>
                    <ToggleButton Name="ShowDesignGuidesToolbar"
                                  Content="Show"
                                  Click="OnShowDesignGuidesMenuClicked"
                                  IsChecked="True"
                                  ToolTip.Tip="Show or hide design guides"
                                  Padding="7,3"/>
                    <ToggleButton Name="SnapToGuidesToolbar"
                                  Content="Snap"
                                  Click="OnSnapToGuidesMenuClicked"
                                  IsChecked="True"
                                  ToolTip.Tip="Toggle snapping to design guides"
                                  Padding="7,3"/>
                    <Button Content="Clear"
                            Click="OnClearDesignGuidesMenuClicked"
                            ToolTip.Tip="Clear all design guides from the current document tab"
                            Padding="7,3"/>
                    <Border Width="1" Background="#CBD5E1" Margin="0,2"/>
                    <Button Content="Fit"
                            Click="OnFitToViewMenuClicked"
                            ToolTip.Tip="Fit the artboard to the viewport"
                            Padding="8,3"/>
                    <Button Content="Fit Sel"
                            Click="OnFitSelectedToViewMenuClicked"
                            IsEnabled="{Binding Canvas.IsSelectionActive}"
                            ToolTip.Tip="Fit the selection to the viewport"
                            Padding="7,3"/>
                    <Button Content="-"
                            Click="OnZoomOutMenuClicked"
                            ToolTip.Tip="Zoom out"
                            MinWidth="28"
                            Padding="5,3"/>
                    <TextBlock Text="{Binding Canvas.ZoomPercentage}"
                               VerticalAlignment="Center"
                               MinWidth="52"
                               TextAlignment="Center"
                               FontSize="11"
                               Foreground="#475569"/>
                    <Button Content="+"
                            Click="OnZoomInMenuClicked"
                            ToolTip.Tip="Zoom in"
                            MinWidth="28"
                            Padding="5,3"/>
                    <Button Content="100%"
                            Click="OnResetZoomMenuClicked"
                            ToolTip.Tip="Reset zoom to actual size"
                            Padding="7,3"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border DockPanel.Dock="Top"
                Background="#F3F4F6"
                BorderBrush="#CBD5E1"
                BorderThickness="0,0,0,1"
                Padding="6,4"
                IsVisible="{Binding HasMultipleDocumentTabs}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden">
                <ItemsControl ItemsSource="{Binding DocumentTabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DocumentTabViewModel">
                            <Border Background="{Binding TabBackground}"
                                    BorderBrush="{Binding TabBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="2"
                                    ToolTip.Tip="{Binding DocumentPath}"
                                    DragDrop.AllowDrop="True"
                                    DragDrop.DragOver="OnDocumentTabDragOver"
                                    DragDrop.DragLeave="OnDocumentTabDragLeave"
                                    DragDrop.Drop="OnDocumentTabDrop">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Move Tab Left"
                                                  Tag="{Binding}"
                                                  Click="OnMoveDocumentTabLeftMenuClicked"/>
                                        <MenuItem Header="Move Tab Right"
                                                  Tag="{Binding}"
                                                  Click="OnMoveDocumentTabRightMenuClicked"/>
                                        <MenuItem Header="Duplicate Tab"
                                                  Tag="{Binding}"
                                                  Click="OnDuplicateDocumentTabMenuClicked"/>
                                        <MenuItem Header="Rename Tab..."
                                                  Tag="{Binding}"
                                                  Click="OnRenameDocumentTabMenuClicked"/>
                                        <Separator/>
                                        <MenuItem Header="Close Tab"
                                                  Tag="{Binding}"
                                                  Click="OnCloseDocumentTabMenuClicked"/>
                                        <MenuItem Header="Close Tabs to Right"
                                                  Tag="{Binding}"
                                                  Click="OnCloseDocumentTabsToRightMenuClicked"/>
                                        <MenuItem Header="Close Other Tabs"
                                                  Tag="{Binding}"
                                                  Click="OnCloseOtherDocumentTabsMenuClicked"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Content="{Binding Header}"
                                            Tag="{Binding}"
                                            Click="OnDocumentTabClicked"
                                            PointerPressed="OnDocumentTabPointerPressed"
                                            PointerMoved="OnDocumentTabPointerMoved"
                                            PointerReleased="OnDocumentTabPointerReleased"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{Binding TabForeground}"
                                            Padding="8,4"/>
                                    <Button Content="x"
                                            Tag="{Binding}"
                                            Click="OnDocumentTabCloseClicked"
                                            IsEnabled="{Binding CanClose}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{Binding TabForeground}"
                                            Padding="5,4"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border DockPanel.Dock="Bottom" Height="24" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock Text="{Binding Canvas.ZoomPercentage}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0" Foreground="#CCCCCC"/>
                <TextBlock Text="{Binding HistorySummary}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0" Foreground="#9CDCFE"/>
                <Border DockPanel.Dock="Right"
                        Background="#374151"
                        BorderBrush="#64748B"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="5,1"
                        Margin="4,2">
                    <TextBlock Text="{Binding RootKindLabel}"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="#E2E8F0"/>
                </Border>
                <Border DockPanel.Dock="Right"
                        Background="#0F766E"
                        BorderBrush="#2DD4BF"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="6,1"
                        Margin="4,2"
                        IsVisible="{Binding HasSampleData}">
                    <TextBlock Text="SAMPLE DATA"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="#CCFBF1"/>
                </Border>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="8,0" Foreground="#CCCCCC"/>
            </DockPanel>
        </Border>

        <Grid Name="WorkspaceGrid" ColumnDefinitions="220,4,*,4,280">
            <Border Name="ToolboxPane" Grid.Column="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="8,6">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        IsVisible="{Binding Toolbox.IsPlacementModeActive}">
                                <TextBlock Text="{Binding Toolbox.PlacementModeLabel}"
                                           VerticalAlignment="Center"
                                           FontSize="10"
                                           Foreground="#9CDCFE"/>
                                <Button Content="{Binding Toolbox.PlacementModeButtonText}"
                                        Padding="5,1"
                                        MinWidth="48"
                                        Height="22"
                                        Click="OnCancelToolboxPlacementModeClicked"/>
                            </StackPanel>
                            <TextBlock Text="Toolbox"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="#CCCCCC"/>
                        </DockPanel>
                    </Border>
                    <TextBox Name="ToolboxSearch"
                             DockPanel.Dock="Top"
                             Margin="6"
                             Watermark="Find control..."
                             Text="{Binding Toolbox.SearchText, Mode=TwoWay}"
                             KeyDown="OnToolboxSearchKeyDown"/>
                    <ComboBox DockPanel.Dock="Top"
                              Margin="6,0,6,4"
                              ItemsSource="{Binding Toolbox.CategoryOptions}"
                              SelectedItem="{Binding Toolbox.CategoryFilter, Mode=TwoWay}"/>
                    <TextBlock DockPanel.Dock="Top" Margin="8,0,8,4" Text="{Binding Toolbox.SearchResultText}" FontSize="11" Foreground="#9CDCFE"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Toolbox.Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Margin="3,2"
                                              IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                        <Expander.Header>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Category}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#D7E3F4"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ItemCount}"
                                                           Margin="8,0,2,0"
                                                           Foreground="#8B949E"/>
                                            </Grid>
                                        </Expander.Header>
                                        <ListBox ItemsSource="{Binding Items}"
                                                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 KeyDown="OnToolboxKeyDown">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="5,4"
                                                            Margin="3,1"
                                                            Background="{Binding RowBackground}"
                                                            BorderBrush="{Binding RowBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            PointerPressed="OnToolboxItemPointerPressed"
                                                            PointerMoved="OnToolboxItemPointerMoved"
                                                            PointerReleased="OnToolboxItemPointerReleased">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <Border Background="#3A3F41"
                                                                    CornerRadius="2"
                                                                    Padding="4,1"
                                                                    VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding CategoryLabel}"
                                                                           FontSize="9"
                                                                           Foreground="#9CDCFE"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1"
                                                                        Margin="6,0,0,0">
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#E6E6E6"/>
                                                                <TextBlock Text="{Binding AvaloniaTypeName}"
                                                                           FontSize="9"
                                                                           Foreground="#8B949E"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="2"
                                                                    Width="24"
                                                                    Height="22"
                                                                    Padding="0"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Content="{Binding FavoriteGlyph}"
                                                                    Foreground="#FBBF24"
                                                                    ToolTip.Tip="{Binding FavoriteToolTip}"
                                                                    Click="OnToggleToolboxFavoriteClicked"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Name="ToolboxSplitter" Grid.Column="1" Background="#3F3F46" ResizeDirection="Columns"/>

            <Border Grid.Column="2" Background="#1E1E1E">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="8,6" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal"
                                        Spacing="5"
                                        IsVisible="{Binding Canvas.IsSelectionActive}">
                                <Button Content="Up"
                                        Click="OnSelectionParentButtonClicked"
                                        IsEnabled="{Binding Canvas.CanNavigateHierarchy}"
                                        ToolTip.Tip="Select the selected control's parent"
                                        Padding="7,2"/>
                                <Button Content="Into"
                                        Click="OnSelectionChildButtonClicked"
                                        IsEnabled="{Binding Canvas.CanNavigateHierarchy}"
                                        ToolTip.Tip="Enter the selected container's first child"
                                        Padding="7,2"/>
                                <ItemsControl ItemsSource="{Binding Canvas.SelectionPathSegments}"
                                              MaxWidth="340"
                                              ToolTip.Tip="Click a hierarchy segment to select it">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="1">
                                                <TextBlock Text="/"
                                                           IsVisible="{Binding HasSeparator}"
                                                           VerticalAlignment="Center"
                                                           Foreground="#64748B"/>
                                                <Button Content="{Binding DisplayName}"
                                                        Tag="{Binding Element}"
                                                        Click="OnSelectionBreadcrumbSegmentClicked"
                                                        Padding="3,2"
                                                        FontSize="11"
                                                        Foreground="#A5F3FC"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Canvas.SelectionPathSummary}"
                                           IsVisible="{Binding Canvas.HasMultipleSelection}"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="#A5F3FC"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        IsVisible="{Binding HasStylePreviewOptions}">
                                <TextBlock Text="State"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="#9CA3AF"/>
                                <ComboBox Width="142"
                                          Height="24"
                                          ItemsSource="{Binding StylePreviewOptions}"
                                          SelectedItem="{Binding SelectedStylePreviewOption, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Text="Design Surface" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                            <TextBlock Text="{Binding Canvas.SelectionBoundsSummary}"
                                       IsVisible="{Binding Canvas.IsSelectionActive}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       FontSize="11"
                                       Foreground="#7DD3FC"
                                       ToolTip.Tip="Selection bounds in artboard coordinates"/>
                        </DockPanel>
                    </Border>
                    <Grid Margin="24" RowDefinitions="24,*" ColumnDefinitions="24,*">
                        <Border Grid.Row="0" Grid.Column="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1,1,0,0"/>
                        <views:DesignerRuler Name="HorizontalRuler"
                                              Grid.Row="0"
                                              Grid.Column="1"
                                              Orientation="Horizontal"
                                              ZoomScale="1"
                                              ScrollOffset="0"
                                              PointerPressed="OnDesignRulerPointerPressed"/>
                        <views:DesignerRuler Name="VerticalRuler"
                                              Grid.Row="1"
                                              Grid.Column="0"
                                              Orientation="Vertical"
                                              ZoomScale="1"
                                              ScrollOffset="0"
                                              PointerPressed="OnDesignRulerPointerPressed"/>
                        <Border Name="DesignViewport"
                                Grid.Row="1"
                                Grid.Column="1"
                                Background="#252526"
                                BorderBrush="#3F3F46"
                                BorderThickness="1"
                                ClipToBounds="True"
                                PointerPressed="OnDesignViewportPointerPressed"
                                PointerMoved="OnDesignViewportPointerMoved"
                                PointerReleased="OnDesignViewportPointerReleased"
                                PointerExited="OnDesignViewportPointerExited"
                                PointerWheelChanged="OnDesignViewportPointerWheelChanged">
                        <ScrollViewer Name="DesignScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalContentAlignment="Left"
                                      VerticalContentAlignment="Top">
                            <Border Width="{Binding Canvas.ZoomedArtboardWidth}"
                                    Height="{Binding Canvas.ZoomedArtboardHeight}">
                                <Border Width="{Binding Canvas.ArtboardWidth}"
                                        Height="{Binding Canvas.ArtboardHeight}"
                                        Background="{Binding Canvas.ArtboardBrush}"
                                        RenderTransformOrigin="0,0">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding Canvas.ZoomScale}" ScaleY="{Binding Canvas.ZoomScale}"/>
                                    </Border.RenderTransform>
                                    <Panel Name="DesignSurface"
                                   DragDrop.AllowDrop="True"
                                   DragDrop.DragEnter="OnDesignSurfaceDragEnter"
                                   DragDrop.DragLeave="OnDesignSurfaceDragLeave"
                                   DragDrop.DragOver="OnDesignSurfaceDragOver"
                                   DragDrop.Drop="OnDesignSurfaceDrop">
                            <Panel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy"
                                              Click="OnCopyMenuClicked"
                                              IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                                    <MenuItem Header="Copy Style"
                                              Click="OnCopyStyleMenuClicked"
                                              IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                                    <MenuItem Header="Cut"
                                              Click="OnCutMenuClicked"
                                              IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                                    <MenuItem Header="Paste" Click="OnPasteMenuClicked"/>
                                    <MenuItem Header="Paste Style"
                                              Click="OnPasteStyleMenuClicked"
                                              IsEnabled="{Binding CanPasteStyle}"/>
                                    <MenuItem Header="Paste AXAML from Clipboard" Click="OnPasteAxamlFromClipboardMenuClicked"/>
                                    <MenuItem Header="Duplicate"
                                              Click="OnDuplicateMenuClicked"
                                              IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                                    <MenuItem Header="Delete"
                                              Click="OnDeleteMenuClicked"
                                              IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                                    <MenuItem Header="Select All" Click="OnSelectAllMenuClicked"/>
                                    <Separator/>
                                    <MenuItem Header="Lock / Unlock Selection"
                                              Click="OnToggleLockMenuClicked"
                                              IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                                    <MenuItem Header="Order" IsEnabled="{Binding Canvas.IsSelectionActive}">
                                        <MenuItem Header="Bring to Front" Click="OnBringToFrontMenuClicked"/>
                                        <MenuItem Header="Send to Back" Click="OnSendToBackMenuClicked"/>
                                        <MenuItem Header="Bring Forward" Click="OnBringForwardMenuClicked"/>
                                        <MenuItem Header="Send Backward" Click="OnSendBackwardMenuClicked"/>
                                    </MenuItem>
                                    <MenuItem Header="Arrange" IsEnabled="{Binding Canvas.HasMultipleSelection}">
                                        <MenuItem Header="Align Left" Click="OnAlignLeftMenuClicked"/>
                                        <MenuItem Header="Align Center" Click="OnAlignCenterMenuClicked"/>
                                        <MenuItem Header="Align Right" Click="OnAlignRightMenuClicked"/>
                                        <MenuItem Header="Align Top" Click="OnAlignTopMenuClicked"/>
                                        <MenuItem Header="Align Middle" Click="OnAlignMiddleMenuClicked"/>
                                        <MenuItem Header="Align Bottom" Click="OnAlignBottomMenuClicked"/>
                                        <Separator/>
                                        <MenuItem Header="Distribute Horizontally" Click="OnDistributeHorizontallyMenuClicked"/>
                                        <MenuItem Header="Distribute Vertically" Click="OnDistributeVerticallyMenuClicked"/>
                                    </MenuItem>
                                    <MenuItem Name="EditSelectionBoundsContextMenu"
                                              Header="Edit Selection Bounds... (Ctrl+Alt+B)"
                                              Click="OnEditSelectionBoundsMenuClicked"
                                              IsEnabled="{Binding Canvas.HasMultipleSelection}"/>
                                    <MenuItem Name="EditCommonPropertiesContextMenu"
                                              Header="Edit Common Properties... (Ctrl+Alt+M)"
                                              Click="OnEditCommonPropertiesMenuClicked"
                                              IsEnabled="{Binding Canvas.HasMultipleSelection}"/>
                                    <MenuItem Name="EditLayoutPropertiesContextMenu"
                                              Header="Edit Layout Properties... (Ctrl+Alt+L)"
                                              Click="OnEditLayoutPropertiesMenuClicked"
                                              IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                                    <MenuItem Name="EditTypographyPropertiesContextMenu"
                                              Header="Edit Typography Properties... (Ctrl+Alt+Y)"
                                              Click="OnEditTypographyPropertiesMenuClicked"
                                              IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                                    <MenuItem Name="EditTransformPropertiesContextMenu"
                                              Header="Edit Transform Properties... (Ctrl+Alt+X)"
                                              Click="OnEditTransformPropertiesMenuClicked"
                                              IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                                    <MenuItem Name="EditAccessibilityPropertiesContextMenu"
                                              Header="Edit Accessibility &amp; Navigation... (Ctrl+Alt+A)"
                                              Click="OnEditAccessibilityPropertiesMenuClicked"
                                              IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                                    <MenuItem Name="EditInteractionPropertiesContextMenu"
                                              Header="Edit Interaction &amp; Rendering... (Ctrl+Alt+E)"
                                              Click="OnEditInteractionPropertiesMenuClicked"
                                              IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                                    <MenuItem Name="EditEffectPropertiesContextMenu"
                                              Header="Edit Visual Effects... (Ctrl+Alt+F)"
                                              Click="OnEditEffectPropertiesMenuClicked"
                                              IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                                    <MenuItem Name="EditRangePropertiesContextMenu"
                                              Header="Edit Range &amp; Value... (Ctrl+Alt+Shift+R)"
                                              Click="OnEditRangePropertiesMenuClicked"
                                              IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                                    <MenuItem Name="EditTextInputPropertiesContextMenu"
                                              Header="Edit Text Input... (Ctrl+Alt+Shift+T)"
                                              Click="OnEditTextInputPropertiesMenuClicked"
                                              IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                                    <MenuItem Name="EditSelectableTextBlockPropertiesContextMenu"
                                              Header="Edit SelectableTextBlock... (Ctrl+Alt+Shift+B)"
                                              Click="OnEditSelectableTextBlockPropertiesMenuClicked"
                                              IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                                    <MenuItem Name="EditMaskedTextBoxPropertiesContextMenu"
                                              Header="Edit MaskedTextBox... (Ctrl+Alt+Shift+M)"
                                              Click="OnEditMaskedTextBoxPropertiesMenuClicked"
                                              IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                                    <MenuItem Name="EditSelectionPropertiesContextMenu"
                                              Header="Edit Selection Behavior... (Ctrl+Alt+Shift+Q)"
                                              Click="OnEditSelectionPropertiesMenuClicked"
                                              IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                                    <MenuItem Name="EditDateTimePropertiesContextMenu"
                                              Header="Edit Date &amp; Time Input... (Ctrl+Alt+Shift+D)"
                                              Click="OnEditDateTimePropertiesMenuClicked"
                                              IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                                    <MenuItem Name="EditColorPickerPropertiesContextMenu"
                                              Header="Edit ColorPicker... (Ctrl+Alt+Shift+P)"
                                              Click="OnEditColorPickerPropertiesMenuClicked"
                                              IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                                    <MenuItem Name="EditAutoCompleteBoxPropertiesContextMenu"
                                              Header="Edit AutoCompleteBox... (Ctrl+Alt+Shift+A)"
                                              Click="OnEditAutoCompleteBoxPropertiesMenuClicked"
                                              IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                                    <MenuItem Name="EditTogglePropertiesContextMenu"
                                              Header="Edit Toggle &amp; Choice Behavior... (Ctrl+Alt+Shift+O)"
                                              Click="OnEditTogglePropertiesMenuClicked"
                                              IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                                    <MenuItem Name="EditContainerBehaviorPropertiesContextMenu"
                                              Header="Edit Disclosure &amp; Scrolling... (Ctrl+Alt+Shift+U)"
                                              Click="OnEditContainerBehaviorPropertiesMenuClicked"
                                              IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                                    <MenuItem Name="EditSplitViewPropertiesContextMenu"
                                              Header="Edit SplitView Pane Behavior... (Ctrl+Alt+Shift+V)"
                                              Click="OnEditSplitViewPropertiesMenuClicked"
                                              IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                                    <MenuItem Name="EditTabControlBehaviorPropertiesContextMenu"
                                              Header="Edit TabControl Behavior... (Ctrl+Alt+Shift+K)"
                                              Click="OnEditTabControlBehaviorPropertiesMenuClicked"
                                              IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                                    <MenuItem Name="EditDataGridBehaviorPropertiesContextMenu"
                                              Header="Edit DataGrid Behavior... (Ctrl+Alt+Shift+E)"
                                              Click="OnEditDataGridBehaviorPropertiesMenuClicked"
                                              IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                                    <MenuItem Name="EditGridSplitterPropertiesContextMenu"
                                              Header="Edit GridSplitter Behavior... (Ctrl+Alt+Shift+J)"
                                              Click="OnEditGridSplitterPropertiesMenuClicked"
                                              IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                                    <MenuItem Header="Center on Artboard" IsEnabled="{Binding Canvas.IsSelectionActive}">
                                        <MenuItem Header="Horizontally" Click="OnCenterHorizontallyOnArtboardMenuClicked"/>
                                        <MenuItem Header="Vertically" Click="OnCenterVerticallyOnArtboardMenuClicked"/>
                                        <MenuItem Header="Both" Click="OnCenterOnArtboardMenuClicked"/>
                                    </MenuItem>
                                    <MenuItem Header="Align to Artboard" IsEnabled="{Binding Canvas.IsSelectionActive}">
                                        <MenuItem Header="Left" Click="OnAlignLeftToArtboardMenuClicked"/>
                                        <MenuItem Header="Right" Click="OnAlignRightToArtboardMenuClicked"/>
                                        <MenuItem Header="Top" Click="OnAlignTopToArtboardMenuClicked"/>
                                        <MenuItem Header="Bottom" Click="OnAlignBottomToArtboardMenuClicked"/>
                                    </MenuItem>
                                    <MenuItem Header="Group Selected into Canvas"
                                              Click="OnGroupSelectedMenuClicked"
                                              IsEnabled="{Binding Canvas.HasMultipleSelection}"/>
                                    <MenuItem Header="Break Selected Layout"
                                              Click="OnBreakSelectedLayoutMenuClicked"
                                              IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                                    <MenuItem Header="Ungroup Selected Canvas"
                                              Click="OnUngroupSelectedMenuClicked"
                                              IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                                    <Separator/>
                                    <MenuItem Header="Live Preview" Click="OnPreviewMenuClicked"/>
                                    <MenuItem Header="Fit to View" Click="OnFitToViewMenuClicked"/>
                                    <MenuItem Header="Fit Selected to View (Ctrl+Shift+F)"
                                              Click="OnFitSelectedToViewMenuClicked"
                                              IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                                </ContextMenu>
                            </Panel.ContextMenu>
                            <views:DesignerGridOverlay GridSize="{Binding Canvas.GridSize}"
                                                      IsGridVisible="{Binding Canvas.IsGridVisible}"
                                                      IsHitTestVisible="False"/>
                            <Border Name="ToolboxPlacementPreview"
                                    Background="#3034D399"
                                    BorderBrush="#22D3EE"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="4"
                                    ZIndex="45"
                                    IsHitTestVisible="False"
                                    IsVisible="False">
                                <StackPanel Spacing="1">
                                    <TextBlock Name="ToolboxPlacementPreviewLabel"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#E0F2FE"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Name="ToolboxPlacementPreviewDetails"
                                               FontSize="9"
                                               Foreground="#BAE6FD"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Name="ToolboxPlacementTargetHint"
                                    Background="#12F59E0B"
                                    BorderBrush="#F59E0B"
                                    BorderThickness="2"
                                    CornerRadius="3"
                                    ZIndex="40"
                                    IsHitTestVisible="False"
                                    IsVisible="False"/>
                            <Border Name="ToolboxDropHint"
                                    Background="#243078D7"
                                    BorderBrush="DodgerBlue"
                                    BorderThickness="2"
                                    ZIndex="50"
                                    IsHitTestVisible="False"
                                    IsVisible="False"/>
                            <TextBlock Text="{Binding Canvas.PlaceholderText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#6D6D6D"
                                       FontStyle="Italic"
                                       IsHitTestVisible="False"
                                       IsVisible="{Binding !Canvas.HasElements}"/>
                            <ItemsControl Name="DesignHost"
                                          ItemsSource="{Binding Canvas.Elements}"
                                          Background="Transparent"
                                          Focusable="True"
                                          PointerPressed="OnDesignHostPointerPressed"
                                          PointerMoved="OnDragPointerMoved"
                                          PointerReleased="OnDragPointerReleased">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Background="Transparent"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Styles>
                                    <Style Selector="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{ReflectionBinding X}"/>
                                        <Setter Property="Canvas.Top" Value="{ReflectionBinding Y}"/>
                                    </Style>
                                </ItemsControl.Styles>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DesignElement">
                                        <Border BorderBrush="DodgerBlue"
                                                BorderThickness="{Binding SelectionThickness}"
                                                Width="{Binding Width}"
                                                Height="{Binding Height}"
                                                IsVisible="{Binding IsVisibleOnArtboard}"
                                                PointerPressed="OnElementPointerPressed">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Copy" Click="OnCopyMenuClicked"/>
                                                    <MenuItem Header="Copy Style" Click="OnCopyStyleMenuClicked"/>
                                                    <MenuItem Header="Copy Selected AXAML" Click="OnCopySelectedAxamlMenuClicked"/>
                                                    <MenuItem Header="Cut" Click="OnCutMenuClicked"/>
                                                    <MenuItem Header="Paste Style" Click="OnPasteStyleMenuClicked"/>
                                                    <MenuItem Header="Duplicate" Click="OnDuplicateMenuClicked"/>
                                                    <MenuItem Header="Rename..." Click="OnRenameSelectedControlMenuClicked"/>
                                                    <MenuItem Header="Edit Appearance..." Click="OnEditAppearanceMenuClicked"/>
                                                    <MenuItem Header="Edit DataGrid Behavior... (Ctrl+Alt+Shift+E)" Click="OnEditDataGridBehaviorPropertiesMenuClicked"/>
                                                    <MenuItem Header="Edit Bindings..." Click="OnEditBindingsMenuClicked"/>
                                                    <MenuItem Header="Edit Layout Properties..." Click="OnEditLayoutPropertiesMenuClicked"/>
                                                    <MenuItem Header="Edit Typography Properties..." Click="OnEditTypographyPropertiesMenuClicked"/>
                                                    <MenuItem Header="Edit Transform Properties..." Click="OnEditTransformPropertiesMenuClicked"/>
                                                    <MenuItem Header="Edit Accessibility &amp; Navigation..." Click="OnEditAccessibilityPropertiesMenuClicked"/>
                                                    <MenuItem Header="Edit Interaction &amp; Rendering..." Click="OnEditInteractionPropertiesMenuClicked"/>
                                                    <MenuItem Header="Edit Visual Effects... (Ctrl+Alt+F)" Click="OnEditEffectPropertiesMenuClicked"/>
                                                    <MenuItem Header="Edit Range &amp; Value... (Ctrl+Alt+Shift+R)" Click="OnEditRangePropertiesMenuClicked"/>
                                                    <MenuItem Header="Edit Text Input... (Ctrl+Alt+Shift+T)" Click="OnEditTextInputPropertiesMenuClicked"/>
                                                    <MenuItem Header="Edit SelectableTextBlock... (Ctrl+Alt+Shift+B)" Click="OnEditSelectableTextBlockPropertiesMenuClicked"/>
                                                    <MenuItem Header="Edit MaskedTextBox... (Ctrl+Alt+Shift+M)" Click="OnEditMaskedTextBoxPropertiesMenuClicked"/>
                                                    <MenuItem Header="Edit Selection Behavior... (Ctrl+Alt+Shift+Q)" Click="OnEditSelectionPropertiesMenuClicked"/>
                                                    <MenuItem Header="Edit Date &amp; Time Input... (Ctrl+Alt+Shift+D)" Click="OnEditDateTimePropertiesMenuClicked"/>
                                                    <MenuItem Header="Edit ColorPicker... (Ctrl+Alt+Shift+P)" Click="OnEditColorPickerPropertiesMenuClicked"/>
                                                    <MenuItem Header="Edit AutoCompleteBox... (Ctrl+Alt+Shift+A)" Click="OnEditAutoCompleteBoxPropertiesMenuClicked"/>
                                                    <MenuItem Header="Edit Toggle &amp; Choice Behavior... (Ctrl+Alt+Shift+O)" Click="OnEditTogglePropertiesMenuClicked"/>
                                                    <MenuItem Header="Edit Disclosure &amp; Scrolling... (Ctrl+Alt+Shift+U)" Click="OnEditContainerBehaviorPropertiesMenuClicked"/>
                                                    <MenuItem Header="Edit SplitView Pane Behavior... (Ctrl+Alt+Shift+V)" Click="OnEditSplitViewPropertiesMenuClicked"/>
                                                    <MenuItem Header="Edit TabControl Behavior... (Ctrl+Alt+Shift+K)" Click="OnEditTabControlBehaviorPropertiesMenuClicked"/>
                                                    <MenuItem Header="Edit Image Source &amp; Rendering..." Click="OnEditImagePropertiesMenuClicked"/>
                                                    <MenuItem Header="Edit Button Actions &amp; Commands..." Click="OnEditButtonPropertiesMenuClicked"/>
                                                    <MenuItem Header="Edit Path Data..." Click="OnEditPathDataMenuClicked"/>
                                                    <MenuItem Header="Edit Grid Definitions..." Click="OnEditGridDefinitionsMenuClicked"/>
                                                    <MenuItem Header="Edit GridSplitter Behavior... (Ctrl+Alt+Shift+J)" Click="OnEditGridSplitterPropertiesMenuClicked"/>
                                                    <MenuItem Header="Assign to Grid Cell..." Click="OnAssignToGridCellMenuClicked"/>
                                                    <MenuItem Header="Assign to StackPanel..." Click="OnAssignToStackPanelMenuClicked"/>
                                                    <MenuItem Header="Assign to DockPanel..." Click="OnAssignToDockPanelMenuClicked"/>
                                                    <MenuItem Header="Assign to WrapPanel..." Click="OnAssignToWrapPanelMenuClicked"/>
                                                    <MenuItem Header="Assign to UniformGrid..." Click="OnAssignToUniformGridMenuClicked"/>
                                                    <MenuItem Header="Assign to Canvas..." Click="OnAssignToCanvasMenuClicked"/>
                                                    <MenuItem Header="Assign to TabControl..." Click="OnAssignToTabControlMenuClicked"/>
                                                    <MenuItem Header="Assign to SplitView..." Click="OnAssignToSplitViewMenuClicked"/>
                                                    <MenuItem Header="Assign as Container Content..." Click="OnAssignAsContainerContentMenuClicked"/>
                                                    <MenuItem Header="Move StackPanel Item Earlier" Click="OnMoveStackPanelItemEarlierMenuClicked"/>
                                                    <MenuItem Header="Move StackPanel Item Later" Click="OnMoveStackPanelItemLaterMenuClicked"/>
                                                    <MenuItem Header="Move DockPanel Item Earlier" Click="OnMoveDockPanelItemEarlierMenuClicked"/>
                                                    <MenuItem Header="Move DockPanel Item Later" Click="OnMoveDockPanelItemLaterMenuClicked"/>
                                                    <MenuItem Header="Move WrapPanel Item Earlier" Click="OnMoveWrapPanelItemEarlierMenuClicked"/>
                                                    <MenuItem Header="Move WrapPanel Item Later" Click="OnMoveWrapPanelItemLaterMenuClicked"/>
                                                    <MenuItem Header="Move UniformGrid Item Earlier" Click="OnMoveUniformGridItemEarlierMenuClicked"/>
                                                    <MenuItem Header="Move UniformGrid Item Later" Click="OnMoveUniformGridItemLaterMenuClicked"/>
                                                    <MenuItem Header="Move Canvas Item Earlier" Click="OnMoveCanvasItemEarlierMenuClicked"/>
                                                    <MenuItem Header="Move Canvas Item Later" Click="OnMoveCanvasItemLaterMenuClicked"/>
                                                    <MenuItem Header="Remove from Container" Click="OnRemoveFromContainerMenuClicked"/>
                                                    <MenuItem Header="Delete" Click="OnDeleteMenuClicked"/>
                                                    <Separator/>
                                                    <MenuItem Header="Lock / Unlock Selection" Click="OnToggleLockMenuClicked"/>
                                                    <MenuItem Header="Order">
                                                        <MenuItem Header="Bring to Front" Click="OnBringToFrontMenuClicked"/>
                                                        <MenuItem Header="Send to Back" Click="OnSendToBackMenuClicked"/>
                                                        <MenuItem Header="Bring Forward" Click="OnBringForwardMenuClicked"/>
                                                        <MenuItem Header="Send Backward" Click="OnSendBackwardMenuClicked"/>
                                                    </MenuItem>
                                                    <MenuItem Header="Arrange">
                                                        <MenuItem Header="Align Left" Click="OnAlignLeftMenuClicked"/>
                                                        <MenuItem Header="Align Center" Click="OnAlignCenterMenuClicked"/>
                                                        <MenuItem Header="Align Right" Click="OnAlignRightMenuClicked"/>
                                                        <MenuItem Header="Align Top" Click="OnAlignTopMenuClicked"/>
                                                        <MenuItem Header="Align Middle" Click="OnAlignMiddleMenuClicked"/>
                                                        <MenuItem Header="Align Bottom" Click="OnAlignBottomMenuClicked"/>
                                                        <Separator/>
                                                        <MenuItem Header="Distribute Horizontally" Click="OnDistributeHorizontallyMenuClicked"/>
                                                        <MenuItem Header="Distribute Vertically" Click="OnDistributeVerticallyMenuClicked"/>
                                                        <Separator/>
                                                        <MenuItem Header="Make Same Width" Click="OnMakeSameWidthMenuClicked"/>
                                                        <MenuItem Header="Make Same Height" Click="OnMakeSameHeightMenuClicked"/>
                                                        <MenuItem Header="Make Same Size" Click="OnMakeSameSizeMenuClicked"/>
                                                    </MenuItem>
                                                    <MenuItem Header="Lay Out Selected (Ctrl+Alt+Shift+1..8)">
                                                        <MenuItem Header="Horizontally (StackPanel, Ctrl+Alt+Shift+1)"
                                                                  Click="OnLayoutSelectedHorizontallyMenuClicked"/>
                                                        <MenuItem Header="Vertically (StackPanel, Ctrl+Alt+Shift+2)"
                                                                  Click="OnLayoutSelectedVerticallyMenuClicked"/>
                                                        <MenuItem Header="Grid (Auto, Ctrl+Alt+Shift+3)"
                                                                  Click="OnLayoutSelectedGridMenuClicked"/>
                                                        <MenuItem Header="UniformGrid (Auto, Ctrl+Alt+Shift+4)"
                                                                  Click="OnLayoutSelectedUniformGridMenuClicked"/>
                                                        <MenuItem Header="DockPanel (Horizontal, Ctrl+Alt+Shift+5)"
                                                                  Click="OnLayoutSelectedDockPanelHorizontallyMenuClicked"/>
                                                        <MenuItem Header="DockPanel (Vertical, Ctrl+Alt+Shift+6)"
                                                                  Click="OnLayoutSelectedDockPanelVerticallyMenuClicked"/>
                                                        <MenuItem Header="WrapPanel (Horizontal, Ctrl+Alt+Shift+7)"
                                                                  Click="OnLayoutSelectedWrapPanelHorizontallyMenuClicked"/>
                                                        <MenuItem Header="WrapPanel (Vertical, Ctrl+Alt+Shift+8)"
                                                                  Click="OnLayoutSelectedWrapPanelVerticallyMenuClicked"/>
                                                    </MenuItem>
                                                    <Separator/>
                                                    <MenuItem Header="Group Selected into Canvas (Ctrl+G)" Click="OnGroupSelectedMenuClicked"/>
                                                    <MenuItem Header="Break Selected Layout (Ctrl+Shift+B)" Click="OnBreakSelectedLayoutMenuClicked"/>
                                                    <MenuItem Header="Ungroup Selected Canvas (Ctrl+Shift+U)" Click="OnUngroupSelectedMenuClicked"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                                <ContentPresenter Content="{Binding Visual}"/>
                                                <StackPanel HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="2"
                                                            Spacing="2">
                                                    <Border Background="#B45309"
                                                            CornerRadius="3"
                                                            Padding="3,1"
                                                            HorizontalAlignment="Right"
                                                            IsVisible="{Binding IsLocked}">
                                                        <TextBlock Text="LOCK" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                    <Border Background="#0F766E"
                                                            BorderBrush="#5EEAD4"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Padding="4,1"
                                                            HorizontalAlignment="Right"
                                                            IsVisible="{Binding HasTabOrder}">
                                                        <TextBlock Text="{Binding TabOrderLabel}"
                                                                   FontSize="9"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"/>
                                                    </Border>
                                                    <Border Background="#1D4ED8"
                                                            BorderBrush="#60A5FA"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Padding="4,1"
                                                            HorizontalAlignment="Right"
                                                            IsVisible="{Binding HasStylePreviewState}">
                                                        <TextBlock Text="{Binding StylePreviewStateLabel}"
                                                                   FontSize="9"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"/>
                                                    </Border>
                                                    <Border Background="#166534"
                                                            BorderBrush="#4ADE80"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Padding="4,1"
                                                            HorizontalAlignment="Right"
                                                            IsVisible="{Binding IsGridChild}">
                                                        <TextBlock Text="{Binding GridCellLabel}"
                                                                   FontSize="9"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"/>
                                                    </Border>
                                                    <Border Background="#92400E"
                                                            BorderBrush="#FBBF24"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Padding="4,1"
                                                            HorizontalAlignment="Right"
                                                            IsVisible="{Binding IsStackPanelChild}">
                                                        <TextBlock Text="{Binding StackPanelItemLabel}"
                                                                   FontSize="9"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"/>
                                                    </Border>
                                                    <Border Background="#155E75"
                                                            BorderBrush="#22D3EE"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Padding="4,1"
                                                            HorizontalAlignment="Right"
                                                            IsVisible="{Binding IsContentChild}">
                                                        <TextBlock Text="{Binding ContainerLayoutLabel}"
                                                                   FontSize="9"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"/>
                                                    </Border>
                                                    <Border Background="#7C2D12"
                                                            BorderBrush="#FB923C"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Padding="4,1"
                                                            HorizontalAlignment="Right"
                                                            IsVisible="{Binding IsDockPanelChild}">
                                                        <TextBlock Text="{Binding DockPanelItemLabel}"
                                                                   FontSize="9"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"/>
                                                    </Border>
                                                    <Border Background="#164E63"
                                                            BorderBrush="#67E8F9"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Padding="4,1"
                                                            HorizontalAlignment="Right"
                                                            IsVisible="{Binding IsWrapPanelChild}">
                                                        <TextBlock Text="{Binding WrapPanelItemLabel}"
                                                                   FontSize="9"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"/>
                                                    </Border>
                                                    <Border Background="#365314"
                                                            BorderBrush="#A3E635"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Padding="4,1"
                                                            HorizontalAlignment="Right"
                                                            IsVisible="{Binding IsUniformGridChild}">
                                                        <TextBlock Text="{Binding UniformGridItemLabel}"
                                                                   FontSize="9"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"/>
                                                    </Border>
                                                    <Border Background="#1E3A8A"
                                                            BorderBrush="#60A5FA"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Padding="4,1"
                                                            HorizontalAlignment="Right"
                                                            IsVisible="{Binding IsCanvasChild}">
                                                        <TextBlock Text="{Binding CanvasItemLabel}"
                                                                   FontSize="9"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"/>
                                                    </Border>
                                                    <Border Background="#713F12"
                                                            BorderBrush="#FBBF24"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Padding="4,1"
                                                            HorizontalAlignment="Right"
                                                            IsVisible="{Binding IsTabControlChild}">
                                                        <TextBlock Text="{Binding TabItemLabel}"
                                                                   FontSize="9"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"/>
                                                    </Border>
                                                    <Border Background="#4C1D95"
                                                            BorderBrush="#C4B5FD"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Padding="4,1"
                                                            HorizontalAlignment="Right"
                                                            IsVisible="{Binding IsSplitViewChild}">
                                                        <TextBlock Text="{Binding SplitViewItemLabel}"
                                                                   FontSize="9"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <views:DesignerGuideOverlay Name="GuideOverlay"
                                                        ZIndex="20"
                                                        ArtboardWidth="{Binding Canvas.ArtboardWidth}"
                                                        ArtboardHeight="{Binding Canvas.ArtboardHeight}"
                                                        IsHitTestVisible="False"/>
                            <Canvas Name="SelectionOverlay" ZIndex="30" IsVisible="{Binding Canvas.IsSelectionActive}">
                                <Rectangle Name="SelectionBoundsRectangle"
                                           Fill="Transparent"
                                           Stroke="#60A5FA"
                                           StrokeThickness="1"
                                           IsHitTestVisible="False"/>
                                <Rectangle Name="HandleNW" Tag="NW" Width="10" Height="10" Fill="DodgerBlue" PointerPressed="OnHandlePressed"/>
                                <Rectangle Name="HandleN" Tag="N" Width="10" Height="10" Fill="DodgerBlue" PointerPressed="OnHandlePressed"/>
                                <Rectangle Name="HandleNE" Tag="NE" Width="10" Height="10" Fill="DodgerBlue" PointerPressed="OnHandlePressed"/>
                                <Rectangle Name="HandleE" Tag="E" Width="10" Height="10" Fill="DodgerBlue" PointerPressed="OnHandlePressed"/>
                                <Rectangle Name="HandleSE" Tag="SE" Width="10" Height="10" Fill="DodgerBlue" PointerPressed="OnHandlePressed"/>
                                <Rectangle Name="HandleS" Tag="S" Width="10" Height="10" Fill="DodgerBlue" PointerPressed="OnHandlePressed"/>
                                <Rectangle Name="HandleSW" Tag="SW" Width="10" Height="10" Fill="DodgerBlue" PointerPressed="OnHandlePressed"/>
                                <Rectangle Name="HandleW" Tag="W" Width="10" Height="10" Fill="DodgerBlue" PointerPressed="OnHandlePressed"/>
                            </Canvas>
                            <Canvas IsHitTestVisible="False">
                                <Rectangle Name="SmartSnapVertical" Width="1" Fill="#22D3EE" IsVisible="False"/>
                                <Rectangle Name="SmartSnapHorizontal" Height="1" Fill="#22D3EE" IsVisible="False"/>
                            </Canvas>
                            <Canvas IsHitTestVisible="False">
                                <Rectangle Name="MarqueeRectangle"
                                           Fill="#3078D7FF"
                                           Stroke="DodgerBlue"
                                           StrokeThickness="1"
                                           IsVisible="False"/>
                            </Canvas>
                                    </Panel>
                                </Border>
                            </Border>
                        </ScrollViewer>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Name="InspectorSplitter" Grid.Column="3" Background="#3F3F46" ResizeDirection="Columns"/>

            <Grid Name="InspectorPane" Grid.Column="4" RowDefinitions="*,4,*">
                <Border Name="ObjectTreePane" Grid.Row="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1,0,0,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="8,6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Object Tree" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                                <TextBlock Text="{Binding Canvas.SelectionSummary}"
                                           IsVisible="{Binding Canvas.IsSelectionActive}"
                                           FontSize="11"
                                           Foreground="#9CDCFE"/>
                            </StackPanel>
                        </Border>
                        <TextBox Name="ObjectTreeSearch"
                                 DockPanel.Dock="Top"
                                 Margin="6"
                                 Watermark="Find control... (Enter next)"
                                 KeyDown="OnObjectTreeSearchKeyDown"
                                 Text="{Binding ObjectTree.SearchText, Mode=TwoWay}"/>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding ObjectTree.SearchResultText}"
                                   IsVisible="{Binding ObjectTree.IsSearchActive}"
                                   Margin="8,0,8,6"
                                   FontSize="11"
                                   Foreground="#9CDCFE"/>
                        <TreeView Name="ObjectTreeView"
                                  ItemsSource="{Binding ObjectTree.Nodes}"
                                  SelectedItem="{Binding ObjectTree.SelectedNode, Mode=TwoWay}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Focusable="True"
                                  KeyDown="OnObjectTreeKeyDown"
                                  DragDrop.AllowDrop="True"
                                  DragDrop.DragOver="OnObjectTreeDragOver"
                                  DragDrop.DragLeave="OnObjectTreeDragLeave"
                                  DragDrop.Drop="OnObjectTreeDrop">
                            <TreeView.Styles>
                                <Style Selector="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}"/>
                                </Style>
                            </TreeView.Styles>
                            <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}">
                                    <Grid>
                                        <Border Background="#163B2A"
                                                BorderBrush="#4ADE80"
                                                BorderThickness="1"
                                                CornerRadius="2"
                                                IsVisible="{Binding IsDropTarget}"/>
                                        <Border Background="#452020"
                                                BorderBrush="#F87171"
                                                BorderThickness="1"
                                                CornerRadius="2"
                                                IsVisible="{Binding IsDropRejected}"/>
                                        <Border Background="#67E8F9"
                                                Height="2"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Top"
                                                IsVisible="{Binding IsDropBefore}"/>
                                        <Border Background="#67E8F9"
                                                Height="2"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Bottom"
                                                IsVisible="{Binding IsDropAfter}"/>
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="4"
                                                    PointerPressed="OnObjectTreeNodePointerPressed"
                                                    PointerMoved="OnObjectTreeNodePointerMoved"
                                                    PointerReleased="OnObjectTreeNodePointerReleased">
                                        <StackPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Rename..." Click="OnRenameSelectedControlMenuClicked"/>
                                                <MenuItem Header="Lock / Unlock" Click="OnToggleLockMenuClicked"/>
                                                <MenuItem Header="Assign to Container">
                                                    <MenuItem Header="Grid Cell..." Click="OnAssignToGridCellMenuClicked"/>
                                                    <MenuItem Header="StackPanel..." Click="OnAssignToStackPanelMenuClicked"/>
                                                    <MenuItem Header="DockPanel..." Click="OnAssignToDockPanelMenuClicked"/>
                                                    <MenuItem Header="WrapPanel..." Click="OnAssignToWrapPanelMenuClicked"/>
                                                    <MenuItem Header="UniformGrid..." Click="OnAssignToUniformGridMenuClicked"/>
                                                    <MenuItem Header="Canvas..." Click="OnAssignToCanvasMenuClicked"/>
                                                    <MenuItem Header="TabControl..." Click="OnAssignToTabControlMenuClicked"/>
                                                    <MenuItem Header="SplitView..." Click="OnAssignToSplitViewMenuClicked"/>
                                                    <MenuItem Header="Container Content..." Click="OnAssignAsContainerContentMenuClicked"/>
                                                </MenuItem>
                                                <MenuItem Header="Remove from Container" Click="OnRemoveFromContainerMenuClicked"/>
                                                <MenuItem Header="Move Earlier" Click="OnMoveSelectedElementEarlierMenuClicked"/>
                                                <MenuItem Header="Move Later" Click="OnMoveSelectedElementLaterMenuClicked"/>
                                                <Separator/>
                                                <MenuItem Header="Copy" Click="OnCopyMenuClicked"/>
                                                <MenuItem Header="Cut" Click="OnCutMenuClicked"/>
                                                <MenuItem Header="Duplicate" Click="OnDuplicateMenuClicked"/>
                                                <MenuItem Header="Delete" Click="OnDeleteMenuClicked"/>
                                            </ContextMenu>
                                        </StackPanel.ContextMenu>
                                        <Border Background="#1D4ED8"
                                                CornerRadius="2"
                                                Padding="3,0"
                                                IsVisible="{Binding Element.IsSelected}">
                                            <TextBlock Text="SEL" FontSize="9" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="{Binding DisplayName}"/>
                                        <Border Background="#B45309"
                                                CornerRadius="2"
                                                Padding="3,0"
                                                IsVisible="{Binding Element.IsLocked}">
                                            <TextBlock Text="LOCK" FontSize="9" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                        </StackPanel>
                                    </Grid>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                </Border>

                <GridSplitter Name="ObjectTreeSplitter" Grid.Row="1" Background="#3F3F46" ResizeDirection="Rows"/>

                <Border Name="PropertyInspectorPane" Grid.Row="2" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1,0,0,0">
                    <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="8,6">
                        <Grid RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Properties" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                                <TextBlock Text="{Binding Canvas.SelectedElement.TypeName}"
                                           IsVisible="{Binding Canvas.IsSelectionActive}"
                                           FontSize="10"
                                           Foreground="#9CDCFE"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Spacing="3"
                                        Margin="0,6,0,0">
                                <Button Content="Categories"
                                        Padding="5,2"
                                        FontSize="10"
                                        ToolTip.Tip="Show grouped property categories"
                                        Click="OnPropertyInspectorCategoriesClicked"/>
                                <Button Content="Flat"
                                        Padding="5,2"
                                        FontSize="10"
                                        ToolTip.Tip="Show properties without category groups"
                                        Click="OnPropertyInspectorFlatClicked"/>
                                <Button Content="Expand"
                                        Padding="5,2"
                                        FontSize="10"
                                        ToolTip.Tip="Expand all property categories"
                                        Click="OnPropertyInspectorExpandAllClicked"/>
                                <Button Content="Collapse"
                                        Padding="5,2"
                                        FontSize="10"
                                        ToolTip.Tip="Collapse all property categories"
                                        Click="OnPropertyInspectorCollapseAllClicked"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                        <Border DockPanel.Dock="Top" Padding="8" IsVisible="{Binding Canvas.IsSelectionActive}">
                            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto">
                                <TextBlock Name="LayoutXLabel" Grid.Row="0" Grid.Column="0" Text="X" VerticalAlignment="Center" Margin="0,0,4,4"/>
                                <TextBox Name="LayoutXEditor" Grid.Row="0" Grid.Column="1" GotFocus="OnLayoutEditorGotFocus" LostFocus="OnLayoutEditorLostFocus" Margin="0,0,8,4"/>
                                <TextBlock Name="LayoutYLabel" Grid.Row="0" Grid.Column="2" Text="Y" VerticalAlignment="Center" Margin="0,0,4,4"/>
                                <TextBox Name="LayoutYEditor" Grid.Row="0" Grid.Column="3" GotFocus="OnLayoutEditorGotFocus" LostFocus="OnLayoutEditorLostFocus" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="W" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Name="LayoutWidthEditor" Grid.Row="1" Grid.Column="1" GotFocus="OnLayoutEditorGotFocus" LostFocus="OnLayoutEditorLostFocus" Margin="0,0,8,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="H" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Name="LayoutHeightEditor" Grid.Row="1" Grid.Column="3" GotFocus="OnLayoutEditorGotFocus" LostFocus="OnLayoutEditorLostFocus"/>
                            </Grid>
                        </Border>
                        <Border DockPanel.Dock="Top" Padding="8,0,8,8" IsVisible="{Binding Canvas.IsSelectionActive}">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Name="ElementNameEditor" Grid.Column="1" LostFocus="OnElementNameEditorLostFocus"/>
                            </Grid>
                        </Border>
                        <Grid DockPanel.Dock="Top"
                              ColumnDefinitions="*,Auto"
                              Margin="8,0,8,8">
                            <TextBox Name="PropertyInspectorFilter"
                                     Watermark="Filter properties... (Ctrl+Alt+I)"
                                     TextChanged="OnPropertyInspectorFilterChanged"
                                     KeyDown="OnPropertyInspectorFilterKeyDown"/>
                            <Button Grid.Column="1"
                                    Content="Clear"
                                    Margin="4,0,0,0"
                                    Padding="6,2"
                                    ToolTip.Tip="Clear the property filter"
                                    Click="OnPropertyInspectorFilterClearClicked"/>
                        </Grid>
                        <pg:PropertyGrid Name="PropGrid"
                                         Focusable="True"
                                         IsQuickFilterVisible="True"
                                         IsHeaderVisible="False"
                                         IsCategoryVisible="True"
                                         IsAutoNameWidth="True"
                                         LayoutStyle="Tree"
                                         CategoryOrderStyle="Builtin"
                                         PropertyOrderStyle="Alphabetic"
                                         AllCategoriesExpanded="True"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
