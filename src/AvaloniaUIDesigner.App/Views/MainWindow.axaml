<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaUIDesigner.App.ViewModels"
        xmlns:pg="using:Avalonia.PropertyGrid.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="800"
        x:Class="AvaloniaUIDesigner.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding WindowTitle}"
        Width="1280"
        Height="800"
        Closing="OnWindowClosing"
        KeyDown="OnWindowKeyDown">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="New" Click="OnNewMenuClicked"/>
                <MenuItem Header="Open..." Click="OnOpenMenuClicked"/>
                <MenuItem Header="Open Recent" x:Name="OpenRecentMenu"/>
                <Separator/>
                <MenuItem Header="Save" Click="OnSaveMenuClicked"/>
                <MenuItem Header="Save As..." Click="OnSaveAsMenuClicked"/>
                <Separator/>
                <MenuItem Header="Exit" Click="OnExitMenuClicked"/>
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="Undo" Click="OnUndoMenuClicked" IsEnabled="{Binding CanUndo}"/>
                <MenuItem Header="Redo" Click="OnRedoMenuClicked" IsEnabled="{Binding CanRedo}"/>
                <Separator/>
                <MenuItem Header="Copy" Click="OnCopyMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Paste" Click="OnPasteMenuClicked" IsEnabled="{Binding CanPaste}"/>
                <MenuItem Header="Duplicate" Click="OnDuplicateMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
                <MenuItem Header="Delete" Click="OnDeleteMenuClicked" IsEnabled="{Binding Canvas.IsSelectionActive}"/>
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem Header="Snap to Grid (8px)"
                          IsCheckable="True"
                          IsChecked="{Binding Canvas.SnapToGrid, Mode=TwoWay}"/>
            </MenuItem>
            <MenuItem Header="Help"/>
        </Menu>

        <Border DockPanel.Dock="Bottom" Height="24" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="8,0" Foreground="#CCCCCC"/>
        </Border>

        <Grid ColumnDefinitions="220,4,*,4,280">
            <Border Grid.Column="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="8,6">
                        <TextBlock Text="Toolbox" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                    </Border>
                    <ListBox ItemsSource="{Binding Toolbox.Items}"
                             SelectedItem="{Binding Toolbox.SelectedItem}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" Padding="4,2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Background="#3F3F46" ResizeDirection="Columns"/>

            <Border Grid.Column="2" Background="#1E1E1E">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="8,6" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
                        <TextBlock Text="Design Surface" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                    </Border>
                    <Border Background="#252526" Margin="24" BorderBrush="#3F3F46" BorderThickness="1">
                        <Panel>
                            <TextBlock Text="{Binding Canvas.PlaceholderText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#6D6D6D"
                                       FontStyle="Italic"
                                       IsHitTestVisible="False"
                                       IsVisible="{Binding !Canvas.HasElements}"/>
                            <ItemsControl Name="DesignHost"
                                          ItemsSource="{Binding Canvas.Elements}"
                                          Background="Transparent"
                                          PointerPressed="OnDesignHostPointerPressed"
                                          PointerMoved="OnDragPointerMoved"
                                          PointerReleased="OnDragPointerReleased">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Background="Transparent"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Styles>
                                    <Style Selector="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{ReflectionBinding X}"/>
                                        <Setter Property="Canvas.Top" Value="{ReflectionBinding Y}"/>
                                    </Style>
                                </ItemsControl.Styles>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DesignElement">
                                        <Border BorderBrush="DodgerBlue"
                                                BorderThickness="{Binding SelectionThickness}"
                                                Width="{Binding Width}"
                                                Height="{Binding Height}"
                                                PointerPressed="OnElementPointerPressed">
                                            <ContentPresenter Content="{Binding Visual}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Canvas Name="SelectionOverlay" IsVisible="{Binding Canvas.IsSelectionActive}">
                                <Rectangle Name="HandleNW" Tag="NW" Width="10" Height="10" Fill="DodgerBlue" PointerPressed="OnHandlePressed"/>
                                <Rectangle Name="HandleN" Tag="N" Width="10" Height="10" Fill="DodgerBlue" PointerPressed="OnHandlePressed"/>
                                <Rectangle Name="HandleNE" Tag="NE" Width="10" Height="10" Fill="DodgerBlue" PointerPressed="OnHandlePressed"/>
                                <Rectangle Name="HandleE" Tag="E" Width="10" Height="10" Fill="DodgerBlue" PointerPressed="OnHandlePressed"/>
                                <Rectangle Name="HandleSE" Tag="SE" Width="10" Height="10" Fill="DodgerBlue" PointerPressed="OnHandlePressed"/>
                                <Rectangle Name="HandleS" Tag="S" Width="10" Height="10" Fill="DodgerBlue" PointerPressed="OnHandlePressed"/>
                                <Rectangle Name="HandleSW" Tag="SW" Width="10" Height="10" Fill="DodgerBlue" PointerPressed="OnHandlePressed"/>
                                <Rectangle Name="HandleW" Tag="W" Width="10" Height="10" Fill="DodgerBlue" PointerPressed="OnHandlePressed"/>
                            </Canvas>
                        </Panel>
                    </Border>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" Background="#3F3F46" ResizeDirection="Columns"/>

            <Grid Grid.Column="4" RowDefinitions="*,4,*">
                <Border Grid.Row="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1,0,0,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="8,6">
                            <TextBlock Text="Object Tree" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                        </Border>
                        <TreeView ItemsSource="{Binding ObjectTree.Nodes}"
                                  SelectedItem="{Binding ObjectTree.SelectedNode, Mode=TwoWay}"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Background="#3F3F46" ResizeDirection="Rows"/>

                <Border Grid.Row="2" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1,0,0,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="8,6">
                            <TextBlock Text="Properties" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                        </Border>
                        <pg:PropertyGrid Name="PropGrid" IsQuickFilterVisible="False" IsHeaderVisible="False"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
