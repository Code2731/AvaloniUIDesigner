{
  "name": "Acme Custom Controls",
  "components": [
    {
      "displayName": "Analytics Card",
      "avaloniaTypeName": "Acme.Controls.AnalyticsCard",
      "designOnly": true,
      "category": "Analytics",
      "previewText": "Analytics Card",
      "defaultWidth": 320,
      "defaultHeight": 120,
      "propertyDefinitions": [
        {
          "name": "Header",
          "type": "String",
          "displayName": "Card header",
          "category": "Content",
          "description": "Heading shown above the primary value."
        },
        {
          "name": "Value",
          "type": "String",
          "displayName": "Primary value",
          "category": "Content"
        },
        {
          "name": "Trend",
          "type": "Enum",
          "displayName": "Trend direction",
          "category": "Data",
          "description": "Controls the trend indicator direction.",
          "options": ["Up", "Flat", "Down"]
        },
        {
          "name": "Target",
          "type": "Double",
          "displayName": "Target value",
          "category": "Data",
          "minimum": 0
        },
        {
          "name": "ContentPadding",
          "type": "Thickness",
          "displayName": "Content padding",
          "category": "Layout"
        },
        {
          "name": "CardCorners",
          "type": "CornerRadius",
          "displayName": "Card corners",
          "category": "Appearance"
        },
        {
          "name": "PreferredTrack",
          "type": "GridLength",
          "displayName": "Preferred track",
          "category": "Layout"
        }
      ],
      "defaultProperties": {
        "Header": "Revenue",
        "Value": "$42K",
        "Trend": "Up",
        "Target": "50000",
        "ContentPadding": "16,12",
        "CardCorners": "8",
        "PreferredTrack": "2*",
        "Opacity": "0.85"
      }
    }
  ]
}
